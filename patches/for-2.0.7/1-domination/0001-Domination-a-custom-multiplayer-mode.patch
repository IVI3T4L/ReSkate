diff --git a/Extension/Domination/domination_sync.cpp b/Extension/Domination/domination_sync.cpp
new file mode 100644
index 0000000..d2afe84
--- /dev/null
+++ b/Extension/Domination/domination_sync.cpp
@@ -0,0 +1,408 @@
+#include "domination_sync.h"
+#include "domination_wire.h"
+#include <algorithm>
+#include <cmath>
+#include <stdexcept>
+
+namespace dingosdk::domination::sync {
+std::uint8_t Options::bits() const { return static_cast<std::uint8_t>(teams ? wire::teams : 0); }
+Options Options::from(std::uint8_t b) { return {(b & wire::teams) != 0}; }
+
+Player controller(const Roster &roster) {
+    if (!roster.self) return 0;
+    const auto present = [&](Player who) { return who == roster.self || std::ranges::find(roster.others, who) != roster.others.end(); };
+    if (roster.host && present(roster.host)) return roster.host;
+    Player lowest = roster.self;
+    for (const auto who : roster.others)
+        if (who && who < lowest) lowest = who;
+    return lowest;
+}
+
+// ---- a round ----------------------------------------------------------------------------
+std::uint32_t Match::ms(Ms now) const { return static_cast<std::uint32_t>(std::clamp<Ms>(now - origin, 0, 4'000'000'000LL)); }
+double Match::left_s(Ms now) const {
+    if (finished) return 0;
+    const double played = std::max<double>(0, static_cast<double>(ms(now)) - countdown_ms) / 1000.0;
+    return std::max(0.0, duration_s - played);
+}
+int Match::team_of(Player who) const {
+    const auto it = teams.find(who);
+    return it == teams.end() ? -1 : it->second;
+}
+bool Match::rivals(Player a, Player b) const {
+    if (!a || !b || a == b) return false;
+    if (!with_teams()) return true;
+    const int ta = team_of(a), tb = team_of(b);
+    return ta < 0 || tb < 0 || ta != tb;
+}
+Results Match::standings(Ms now) const {
+    if (finished) return results;
+    Results r;
+    const auto t = with_teams() ? teams : Teams{};
+    r.stats = round_stats(board, std::min(ms(now), end_ms()), t);
+    r.rows = ranked(board, r.stats, t);
+    return r;
+}
+
+// ---- starting and stopping ----------------------------------------------------------------
+StartResult Node::start(Ms now, Options options, std::uint16_t duration_s, bool solo, std::uint32_t id) {
+    if (!spots_) return StartResult::no_spots;
+    if (running() && match_->multiplayer) return StartResult::running;
+    const bool together = !solo && roster_.session();
+    if (together && !controls()) return StartResult::not_controller;
+    if (running()) finish(now, match_->ms(now)); // a solo round gives way
+    Match m;
+    m.id = id ? id : 1;
+    m.self = roster_.self ? roster_.self : solo_self;
+    m.starter = m.self;
+    m.options = options;
+    m.duration_s = duration_s;
+    m.multiplayer = together;
+    m.origin = now;
+    m.board = Board(spots_);
+    m.teams_heard = true;
+    m.joined = now;
+    m.next_resend = now;
+    if (together) m.seen[m.self] = now;
+    match_ = std::move(m);
+    if (together) {
+        left_round_ = 0;
+        send_round(true, 0);
+    }
+    say({Event::Kind::started, match_->self});
+    return StartResult::started;
+}
+
+bool Node::stop(Ms now) {
+    if (!running()) return false;
+    auto &m = *match_;
+    // The controller (or whoever started it) ends it for everyone; anyone else leaves it.
+    const bool ends = !m.multiplayer || m.starter == m.self || controls();
+    const auto at = std::min(m.ms(now), m.end_ms());
+    // Ending it, or (from anyone else) saying this player left it.
+    if (m.multiplayer) send_round(false, at, !ends);
+    if (m.multiplayer && !ends) left_round_ = m.id;
+    finish(now, at, ends);
+    m.left = m.multiplayer && !ends;
+    m.stopper = m.multiplayer && ends;
+    say({ends ? Event::Kind::stopped : Event::Kind::left, m.self});
+    return true;
+}
+
+// The board without the claims made after `end` (a round stopped early: claims a player made
+// before the stop reached them are dropped on every copy alike).
+Board until(const Board &board, std::uint32_t end) {
+    Board kept(board.spots());
+    std::vector<std::pair<std::uint32_t, std::pair<int, domination::Event>>> all;
+    for (std::size_t s = 0; s < board.spots(); ++s)
+        for (const auto &e : board.history(static_cast<int>(s)))
+            if (e.ms <= end) all.push_back({e.ms, {static_cast<int>(s), e}});
+    std::ranges::stable_sort(all, [](const auto &a, const auto &b) { return a.first < b.first; });
+    for (const auto &[ms, item] : all) kept.claim(item.first, item.second.player, item.second.score, ms);
+    return kept;
+}
+
+void Node::finish(Ms now, std::uint32_t ended_ms, bool after) {
+    auto &m = *match_;
+    // Ended for this copy (not just left: `rejoin` may still bring it back): never joined again.
+    if (after && std::ranges::find(over_, m.id) == over_.end()) {
+        over_.push_back(m.id);
+        if (over_.size() > 16) over_.pop_front();
+    }
+    m.finished = true;
+    m.finished_at = now;
+    m.ended_ms = std::min(ended_ms, m.end_ms());
+    if (m.ended_ms < m.end_ms()) m.board = until(m.board, m.ended_ms);
+    recompute();
+    say({Event::Kind::finished, m.self, {}, false, m.ended_ms, m.id});
+    if (m.multiplayer && after) send_board(); // the last word, so that everyone's results agree
+    if (m.multiplayer) m.next_after = now + after_resend_ms;
+}
+void Node::recompute() {
+    auto &m = *match_;
+    const auto t = m.with_teams() ? m.teams : Teams{};
+    m.results.stats = round_stats(m.board, m.ended_ms, t);
+    m.results.rows = ranked(m.board, m.results.stats, t);
+}
+
+// ---- claims -------------------------------------------------------------------------------
+std::optional<ClaimOutcome> Node::take(int spot, Player who, float score, std::uint32_t at) {
+    auto &m = *match_;
+    if (spot < 0 || static_cast<std::size_t>(spot) >= spots_ || !who) return std::nullopt;
+    if (!std::isfinite(score) || score <= 0) return std::nullopt;
+    if (!m.players.contains(who) && m.players.size() >= max_players) return std::nullopt;
+    if (m.board.history_size(spot) >= max_events_per_spot) return std::nullopt;
+    m.players.insert(who);
+    return m.board.claim(spot, who, score, at);
+}
+
+std::optional<Node::Claimed> Node::claim(int spot, float score, Ms now) {
+    if (!running() || match_->counting_down(now)) return std::nullopt;
+    auto &m = *match_;
+    const auto at = m.ms(now);
+    if (at >= m.end_ms()) return std::nullopt;
+    Claimed c;
+    c.score = score;
+    const auto out = take(spot, m.self, c.score, at);
+    if (!out) return std::nullopt;
+    c.outcome = *out;
+    c.ms = at;
+    if (m.multiplayer && out->best) {
+        wire::BoardMessage b{park_, m.id, {{static_cast<std::uint8_t>(spot), m.self, c.score, at}}};
+        outgoing_.push_back(wire::encode(b));
+    }
+    if (out->after != out->before) say({Event::Kind::claim, m.self, *out});
+    return c;
+}
+
+// ---- messages out -------------------------------------------------------------------------
+// `elapsed`: running, this player's time in the round; stopped, the moment it was stopped (or left).
+void Node::send_round(bool running, std::uint32_t elapsed, bool left) {
+    const auto &m = *match_;
+    wire::RoundMessage r{park_, m.id, m.starter, running, m.options.bits(), m.duration_s, elapsed, left};
+    outgoing_.push_back(wire::encode(r));
+}
+// The board as this player knows it: every claim kept, in messages of max_board_entries at most.
+// A board longer than two messages goes out a part at a time, a different part each time. An
+// empty one goes too: it tells the others this player is in the round.
+void Node::send_board() {
+    auto &m = *match_;
+    std::vector<wire::Entry> all;
+    for (std::size_t spot = 0; spot < m.board.spots(); ++spot)
+        for (const auto &e : m.board.history(static_cast<int>(spot)))
+            all.push_back({static_cast<std::uint8_t>(spot), e.player, e.score, e.ms});
+    constexpr std::size_t most = 2 * wire::max_board_entries;
+    std::vector<wire::Entry> part;
+    if (all.size() <= most) part = std::move(all);
+    else {
+        for (std::size_t n = 0; n < most; ++n) part.push_back(all[(m.board_cursor + n) % all.size()]);
+        m.board_cursor = (m.board_cursor + most) % all.size();
+    }
+    std::size_t at = 0;
+    do {
+        const auto count = std::min(wire::max_board_entries, part.size() - at);
+        const auto from = part.begin() + static_cast<std::ptrdiff_t>(at);
+        outgoing_.push_back(wire::encode(wire::BoardMessage{park_, m.id, {from, from + static_cast<std::ptrdiff_t>(count)}}));
+        at += count;
+    } while (at < part.size());
+}
+void Node::send_teams() {
+    const auto &m = *match_;
+    wire::TeamsMessage t{park_, m.id, {}};
+    for (const auto &[who, team] : m.teams)
+        if (t.members.size() < wire::max_team_entries) t.members.emplace_back(who, static_cast<std::uint8_t>(team));
+    outgoing_.push_back(wire::encode(t));
+}
+
+Player Node::authority(Ms now) const {
+    if (!match_) return 0;
+    const auto &m = *match_;
+    const auto c = controller();
+    const auto recent = [&](Player who) {
+        const auto it = m.seen.find(who);
+        return who == m.self || (it != m.seen.end() && now - it->second < gone_ms);
+    };
+    if (c && recent(c)) return c;
+    Player lowest = m.self;
+    for (const auto &[who, when] : m.seen)
+        if (now - when < gone_ms && who < lowest) lowest = who;
+    return lowest;
+}
+
+void Node::tick(Ms now) {
+    if (!match_) return;
+    auto &m = *match_;
+    if (!m.finished) {
+        if (m.ms(now) >= m.end_ms()) {
+            finish(now, m.end_ms());
+            return;
+        }
+        if (!m.multiplayer || now < m.next_resend) return;
+        m.next_resend = now + resend_ms;
+        m.seen[m.self] = now;
+        // Everyone in it says the round runs (late joiners and players coming back hear it from
+        // anyone, even while its authority changes hands); clocks follow only the authority's.
+        send_round(true, m.ms(now));
+        if (authority(now) == m.self) {
+            if (m.with_teams() && (m.teams_heard || now - m.joined >= teams_patience_ms)) {
+                std::vector<Player> playing{m.self};
+                for (const auto &[who, when] : m.seen)
+                    if (who != m.self && now - when < gone_ms) playing.push_back(who);
+                const int before = m.team_of(m.self);
+                m.teams = balance_teams(m.teams, playing);
+                m.teams_heard = true;
+                if (m.team_of(m.self) != before) say({Event::Kind::teams, m.self, {}, false, m.team_of(m.self)});
+                send_teams();
+            }
+        }
+        send_board();
+        return;
+    }
+    // Over: the stop (from whoever stopped it), the teams (from the authority) and the board again,
+    // for whoever missed the last of them: often at first, then now and then for a while (a player
+    // whose connection dropped across the end hears it all when it comes back).
+    // A player who left says so again for a while instead (once may be lost: the others would go on
+    // counting them in it, as its authority even, and nobody would say the round runs).
+    if (m.multiplayer && m.next_after && now >= m.next_after) {
+        const Ms since = now - m.finished_at;
+        if (since > (m.left ? after_window_ms : after_all_ms)) m.next_after = 0;
+        else {
+            m.next_after = now + (since <= after_window_ms ? after_resend_ms : after_slow_ms);
+            if (m.left) {
+                send_round(false, m.ended_ms, true);
+                return;
+            }
+            if (m.stopper) send_round(false, m.ended_ms);
+            if (m.with_teams() && !m.teams.empty() && authority(now) == m.self) send_teams();
+            send_board();
+        }
+    }
+}
+
+// ---- messages in --------------------------------------------------------------------------
+void Node::merge(Player, const wire::BoardMessage &b, Ms now) {
+    auto &m = *match_;
+    const auto latest = m.finished ? static_cast<Ms>(m.ended_ms) : std::min<Ms>(m.end_ms(), static_cast<Ms>(m.ms(now)) + claim_ahead_ms);
+    std::vector<ClaimOutcome> changed;
+    bool any{};
+    for (const auto &e : b.entries) {
+        if (e.ms < countdown_ms || e.ms > latest) continue;
+        const auto out = take(e.spot, e.player, e.score, e.ms);
+        if (!out) continue;
+        // An earlier claim heard late changes the replay (hold times, steals) without raising a best.
+        any = any || out->kept;
+        if (!out->best) continue;
+        if (out->after != out->before) changed.push_back(*out);
+    }
+    // Many owners changed by one message is a catch-up (a player who just joined): quiet. Once the
+    // round is over, claims heard late (up to minutes after) change its results without a word.
+    const bool quiet = changed.size() > 3;
+    if (!m.finished)
+        for (const auto &out : changed) say({Event::Kind::claim, out.player, out, quiet});
+    if (m.finished && any) recompute();
+}
+
+void Node::receive(Player from, std::span<const std::uint8_t> bytes, Ms now) {
+    if (!from) return;
+    const auto message = wire::decode(bytes);
+    if (!message) {
+        // Another build's Domination: said once per player, so they know why rounds don't meet.
+        const auto version = wire::version_of(bytes);
+        if (version && *version != wire::version && told_version_.size() < 256 && told_version_.insert(from).second)
+            say({Event::Kind::version, from, {}, false, *version});
+        return;
+    }
+    const auto seen = [&](Match &m) {
+        if (m.seen.size() < max_players || m.seen.contains(from)) m.seen[from] = now;
+    };
+    const auto ours = [&](std::uint32_t park, std::uint32_t round) {
+        return park == park_ && match_ && match_->multiplayer && match_->id == round;
+    };
+    if (const auto *b = std::get_if<wire::BoardMessage>(&*message)) {
+        if (!ours(b->park, b->round) || from == match_->self) return;
+        auto &m = *match_;
+        // A round over still takes claims made before its end (a trick landed on another player's
+        // last second, or by a player whose connection dropped for a while): all copies end with
+        // all of them.
+        seen(m);
+        merge(from, *b, now);
+        return;
+    }
+    if (const auto *t = std::get_if<wire::TeamsMessage>(&*message)) {
+        if (!ours(t->park, t->round) || from == match_->self) return;
+        auto &m = *match_;
+        // Teams handed out near the end still count for its results.
+        if (m.finished && m.left) return;
+        seen(m);
+        // The authority's word; a player not told yet takes anyone's.
+        if (m.teams_heard && from != authority(now)) return;
+        Teams teams;
+        for (const auto &[who, team] : t->members) teams[who] = team;
+        const int before = m.team_of(m.self);
+        m.teams = std::move(teams);
+        m.teams_heard = true;
+        if (m.finished) recompute();
+        if (m.team_of(m.self) >= 0 && m.team_of(m.self) != before) say({Event::Kind::teams, m.self, {}, false, m.team_of(m.self)});
+        return;
+    }
+    const auto &r = std::get<wire::RoundMessage>(*message);
+    if (r.park != park_) {
+        if (r.running && told_park_.size() < 256 && told_park_.insert(from).second) say({Event::Kind::park, from});
+        return;
+    }
+    if (ours(r.park, r.round)) {
+        auto &m = *match_;
+        seen(m);
+        if (r.left) {
+            m.seen.erase(from); // that player left it: no longer counted in it
+            return;
+        }
+        if (!r.running) {
+            // Stopped, at a moment (from the controller, or relayed by a player whose copy it ended):
+            // every copy ends at it, and a stop that comes after this copy's own end (missed, late,
+            // or near the end) still moves the end back to it. This copy then relays it too.
+            if (m.left) return;
+            if (!m.finished) {
+                finish(now, r.elapsed);
+                m.stopper = true;
+                say({Event::Kind::stopped, from});
+            } else if (r.elapsed < m.ended_ms) {
+                finish(now, r.elapsed);
+                m.stopper = true;
+            }
+            return;
+        }
+        // A player who left and asked to be back in: their copy reopens, and the others' boards
+        // fill in what they missed. (A round that was stopped or ran out never reopens.)
+        if (m.finished && m.left && left_round_ != m.id && static_cast<Ms>(r.elapsed) < static_cast<Ms>(m.end_ms())) {
+            m.finished = m.left = false;
+            m.finished_at = 0;
+            m.ended_ms = 0;
+            m.results = {};
+            m.next_resend = now;
+            m.next_after = 0;
+            m.seen[m.self] = now;
+            say({Event::Kind::joined, m.starter});
+        }
+        // Every clock follows the authority's.
+        if (!m.finished && from != m.self && from == authority(now)) {
+            const auto gap = static_cast<Ms>(r.elapsed) - static_cast<Ms>(m.ms(now));
+            if (gap > clock_slack_ms || gap < -clock_slack_ms) {
+                m.origin -= gap / 2;
+                say({Event::Kind::clock, from, {}, false, gap / 2});
+            }
+        }
+        return;
+    }
+    if (!r.running || r.round == left_round_ || !roster_.self || std::ranges::find(over_, r.round) != over_.end()) return;
+    if (static_cast<Ms>(r.elapsed) >= static_cast<Ms>(r.duration) * 1000 + countdown_ms) return; // over already
+    std::uint32_t moved_from{};
+    if (running()) {
+        auto &m = *match_;
+        if (m.multiplayer) {
+            // Two rounds at once: the lower number stands, while nothing is claimed in the other.
+            if (r.round > m.id || !m.players.empty() || static_cast<Ms>(m.ms(now)) > countdown_ms + 10000) return;
+            moved_from = m.id;
+        } else
+            finish(now, m.ms(now)); // a round of one's own gives way to the session's
+    }
+    Match m;
+    m.id = r.round;
+    m.self = roster_.self;
+    m.starter = r.starter;
+    m.options = Options::from(r.options);
+    m.duration_s = r.duration;
+    m.multiplayer = true;
+    m.origin = now - static_cast<Ms>(r.elapsed);
+    m.board = Board(spots_);
+    m.joined = now;
+    m.next_resend = now; // the first board goes out at once: it tells the others this player is in
+    m.seen[m.self] = now;
+    m.seen[from] = now;
+    match_ = std::move(m);
+    say(moved_from ? Event{Event::Kind::moved, r.starter, {}, false, moved_from} : Event{Event::Kind::joined, r.starter});
+}
+
+std::vector<std::vector<std::uint8_t>> Node::take_outgoing() { return std::exchange(outgoing_, {}); }
+std::vector<Event> Node::take_events() { return std::exchange(events_, {}); }
+} // namespace dingosdk::domination::sync
diff --git a/Extension/Domination/domination_sync.h b/Extension/Domination/domination_sync.h
new file mode 100644
index 0000000..a92cbcc
--- /dev/null
+++ b/Extension/Domination/domination_sync.h
@@ -0,0 +1,202 @@
+#pragma once
+#include "domination_model.h"
+#include "domination_wire.h"
+#include <cstdint>
+#include <deque>
+#include <map>
+#include <optional>
+#include <set>
+#include <span>
+#include <string>
+#include <vector>
+
+// Domination's rounds between players, apart from the game: who runs them, joining, a round's
+// clock, teams, the board every player keeps, and the results. One Node per player. The game
+// gives it the session's players, the player's own tricks and the messages that arrive, each
+// with the time by the player's own clock, and sends what it puts out (domination_wire.h). Every
+// rule that makes the players' games agree is here, so that it can be tested with many players
+// and a bad network (Test/domination_tests.cpp).
+//
+// - Who runs rounds (the controller): the session's host, when the host is a player in it; else
+//   (a dedicated server, or a host who left) the player with the lowest Steam ID. Only the
+//   controller starts a round for everyone and stops it. Outside one, anyone plays alone.
+// - Joining: every player of the session on the map is taken into a round at once, late too, and
+//   out of a round of their own. A player who leaves a round is not taken back into it (not by a
+//   round of their own either); `rejoin` puts them back. Nobody is taken into a round that already
+//   ended for them (a player who missed its stop may still be saying it runs). Leaving says so
+//   (its own message, never taken for a stop): the others stop counting them in the round (its
+//   authority, its teams).
+// - Stopping: the controller (or the round's starter) stops a round for everyone at a moment.
+//   Every copy that ends by a stop says it again with its boards after the end, so a stop missed or
+//   lost on the way (or sent once by a controller who then changed maps) still reaches everyone.
+// - Time: ms since the round started, by each player's own clock. Every clock follows the
+//   round's authority (the controller while it is in the round, else the lowest id in it): a gap
+//   above 300 ms is halved at each of its round messages.
+// - The board: every claim that was ever a player's best on a spot. The same claims make the same
+//   owners and the same replay on every copy (domination_model.h). A new best goes out at once,
+//   the whole board every 5 s, and once the round is over (with the stop, when it was stopped,
+//   and the teams) every 2 s for 10 s, then every 10 s for 3 minutes or until the next round, so a
+//   player whose connection dropped across the end still hears it all when it comes back. Claims
+//   made before the end, and teams, are taken whenever they come while the round is the current
+//   one. A stop that arrives late, even after a copy's own end, moves that copy's end back to the
+//   stop's moment, so a missed or late stop never leaves copies apart.
+// - Teams (an option): handed out by the authority, as even as they can be; nobody is moved once
+//   placed. A player who joins late takes the teams they are told before handing any out.
+// - Two rounds started at once (two controllers, for a moment): the lower round number stands,
+//   and the other's players move to it while nothing has been claimed in theirs.
+namespace dingosdk::domination::sync {
+using Ms = std::int64_t; // a player's own clock, ms
+
+inline constexpr Ms countdown_ms = 4000; // 3, 2, 1, GO before the play; tricks in it count for nothing
+inline constexpr Ms resend_ms = 5000, gone_ms = 25000, teams_patience_ms = 12000, clock_slack_ms = 300;
+inline constexpr Ms after_resend_ms = 2000, after_window_ms = 10000, after_slow_ms = 10000, after_all_ms = 180000;
+inline constexpr Ms claim_ahead_ms = 5000;
+inline constexpr std::size_t max_players = 64, max_events_per_spot = 1024;
+// The player on a solo round's board when the game has no Steam ID (offline).
+inline constexpr Player solo_self = 2;
+
+struct Options {
+    bool teams{}; // red against blue (with other players)
+    std::uint8_t bits() const;
+    static Options from(std::uint8_t bits);
+    bool operator==(const Options &) const = default;
+};
+
+// The session as the game sees it.
+struct Roster {
+    Player self{}; // 0: not in a session
+    Player host{}; // the session's host when it is a player (0: none, e.g. a dedicated server)
+    std::vector<Player> others; // the other connected players
+    bool session() const { return self && !others.empty(); }
+    bool operator==(const Roster &) const = default;
+};
+Player controller(const Roster &roster);
+
+struct Results {
+    RoundStats stats;
+    std::vector<Ranked> rows; // most spots first (ranked); with teams, one row per team
+};
+
+// One round as this player has it.
+struct Match {
+    std::uint32_t id{};
+    Player self{}, starter{};
+    Options options;
+    std::uint16_t duration_s{}; // to play, the countdown not counted
+    bool multiplayer{};
+    Ms origin{};                // when it started, by this player's clock
+    Board board;
+    Teams teams;
+    bool teams_heard{};
+    std::map<Player, Ms> seen;  // participants, when last heard from (this player included)
+    std::set<Player> players;   // everyone with a claim
+    bool finished{};
+    bool left{}; // finished because this player left it (it goes on for the others)
+    bool stopper{}; // it ended by a stop (this player's, or one heard): the stop goes out again with the boards after
+    Ms finished_at{};
+    std::uint32_t ended_ms{};
+    Results results;
+    Ms joined{}, next_resend{}, next_after{};
+    std::size_t board_cursor{};
+
+    std::uint32_t end_ms() const { return static_cast<std::uint32_t>(duration_s) * 1000u + static_cast<std::uint32_t>(countdown_ms); }
+    std::uint32_t ms(Ms now) const;
+    bool counting_down(Ms now) const { return !finished && ms(now) < countdown_ms; }
+    double left_s(Ms now) const; // to play
+    bool with_teams() const { return options.teams && multiplayer; }
+    int team_of(Player who) const;
+    // Whether `a` and `b` play against each other: other players, or in teams the other team (or a
+    // player with no team yet).
+    bool rivals(Player a, Player b) const;
+    // A spot owned by this player, or by their team.
+    bool ours(Player owner) const { return owner && (owner == self || (with_teams() && !rivals(owner, self))); }
+    // The standings now (or, over, the results).
+    Results standings(Ms now) const;
+};
+
+struct Event {
+    enum class Kind {
+        started,      // this player started a round
+        joined,       // this player was taken into another player's round (who: its starter)
+        moved,        // ... out of a round started at the same time (value: the old round)
+        left,         // this player left a round (it stays theirs to look at)
+        stopped,      // the round was stopped (who: by whom; this player if theirs)
+        finished,     // this player's copy ended, or its end moved back (value: ended_ms; round)
+        claim,        // a spot changed hands (claim: what did it; quiet: one of many at once)
+        teams,        // this player's team was set (value: 0 red, 1 blue)
+        version,      // a player sends another version of Domination's messages (value: theirs)
+        park,         // a player plays another version of this park
+        clock,        // this player's clock followed the authority's (value: ms moved)
+    } kind{};
+    Player who{};
+    ClaimOutcome claim;
+    bool quiet{};
+    std::int64_t value{};
+    std::uint32_t round{}; // the round it is about
+};
+
+enum class StartResult { started, running, not_controller, no_spots };
+
+class Node {
+public:
+    Node(std::uint32_t park, std::size_t spots) : park_(park), spots_(spots) {}
+    void set_roster(const Roster &roster) { roster_ = roster; }
+    const Roster &roster() const { return roster_; }
+    Player controller() const { return sync::controller(roster_); }
+    // In a session, whether this player runs its rounds.
+    bool controls() const { return roster_.self && controller() == roster_.self; }
+    // A round with everyone in the session (the controller only), or alone (anyone, outside a
+    // round of the session's); `id` a fresh round number (not 0). Every round starts with every
+    // spot open.
+    StartResult start(Ms now, Options options, std::uint16_t duration_s, bool solo, std::uint32_t id);
+    // The controller (or the round's starter) ends the round for everyone; anyone else leaves it.
+    // False: no round running.
+    bool stop(Ms now);
+    // This player's trick: claimed at once, and sent when it raises their best. Empty: no round to
+    // claim in (or it counts down).
+    struct Claimed {
+        ClaimOutcome outcome;
+        float score{};
+        std::uint32_t ms{}; // when, by the round's clock (a stop before it drops it)
+    };
+    std::optional<Claimed> claim(int spot, float score, Ms now);
+    // A Domination message from another player (domination_wire.h).
+    void receive(Player from, std::span<const std::uint8_t> bytes, Ms now);
+    // Resends, the authority's duties and the end; call often.
+    void tick(Ms now);
+    std::vector<std::vector<std::uint8_t>> take_outgoing();
+    std::vector<Event> take_events();
+    const std::optional<Match> &match() const { return match_; }
+    bool running() const { return match_ && !match_->finished; }
+    // A player who left the session's round is taken into it again with its next message (their
+    // copy of it reopens and catches up from the others' boards).
+    void rejoin() { left_round_ = 0; }
+    // Who keeps the round's clock and hands out its teams.
+    Player authority(Ms now) const;
+    std::uint32_t park() const { return park_; }
+    std::size_t spots() const { return spots_; }
+
+private:
+    void send_round(bool running, std::uint32_t elapsed, bool left = false);
+    void send_board();
+    void send_teams();
+    // Ends this player's copy at `ended_ms` (a stop earlier than an end already had moves it back).
+    // `after`: the boards (and a stop, the teams) go out again for a while, for whoever missed them.
+    void finish(Ms now, std::uint32_t ended_ms, bool after = true);
+    void recompute();
+    void merge(Player from, const wire::BoardMessage &board, Ms now);
+    std::optional<ClaimOutcome> take(int spot, Player who, float score, std::uint32_t at);
+    void say(Event event) { if (events_.size() < 256) events_.push_back(std::move(event)); }
+    std::uint32_t park_;
+    std::size_t spots_;
+    Roster roster_;
+    std::optional<Match> match_;
+    std::uint32_t left_round_{}; // a round this player left: not joined again
+    // The last rounds that ended here: never joined again (a player who missed one's stop may still
+    // be saying it runs, just as the next round starts).
+    std::deque<std::uint32_t> over_;
+    std::set<Player> told_version_, told_park_;
+    std::vector<std::vector<std::uint8_t>> outgoing_;
+    std::vector<Event> events_;
+};
+} // namespace dingosdk::domination::sync
diff --git a/Extension/Domination/domination_tools.cpp b/Extension/Domination/domination_tools.cpp
new file mode 100644
index 0000000..91a9392
--- /dev/null
+++ b/Extension/Domination/domination_tools.cpp
@@ -0,0 +1,189 @@
+#include "domination.h"
+#include "domination_internal.h"
+#include "Engine/Game/Multiplayer/session_tools.h"
+#include "Extension/Multiplayer/Session/session.h"
+#include "Extension/Profile/local_profile_runtime.h"
+#include "Extension/World/level_loading.h"
+#include <algorithm>
+#include <format>
+#include <sstream>
+
+// Park-making: height maps (scan), a teleport facing a heading (tp), and surveys of many places
+// (domination_internal.h, README.md "Making a park").
+namespace dingosdk::domination::detail {
+// ---- scan -------------------------------------------------------------------------------
+void finish_scan(State &s) {
+    auto &scan = *s.scan;
+    const auto seconds = std::chrono::duration<double>(Clock::now() - scan.started).count();
+    const auto directory = data_directory();
+    std::error_code error;
+    std::filesystem::create_directories(directory, error);
+    const auto path = directory / std::filesystem::path("scan-" + stamp() + ".bin");
+    std::ofstream file(path, std::ios::binary | std::ios::trunc);
+    if (file) {
+        file.write("DOMSCAN1", 8);
+        file.write(reinterpret_cast<const char *>(&scan.nx), 4);
+        file.write(reinterpret_cast<const char *>(&scan.nz), 4);
+        for (const float value : {scan.x0, scan.z0, scan.step, scan.top, scan.bottom}) file.write(reinterpret_cast<const char *>(&value), 4);
+        file.write(reinterpret_cast<const char *>(scan.heights.data()), static_cast<std::streamsize>(scan.heights.size() * sizeof(float)));
+    }
+    if (file) {
+        s.last_scan = path.string();
+        say(logging::Level::info, std::format("scan done: {} x {} points, {} without a hit, {:.1f} s. File: {}", scan.nx, scan.nz,
+                                              scan.misses, seconds, s.last_scan));
+    } else {
+        s.last_scan = "error: could not write " + path.string();
+        say(logging::Level::warning, "scan " + s.last_scan);
+    }
+    s.scan.reset();
+}
+void tick_scan(State &s) {
+    if (!s.scan) return;
+    auto &scan = *s.scan;
+    const auto until = Clock::now() + scan_budget;
+    while (scan.next < scan.heights.size() && Clock::now() < until) {
+        const auto i = scan.next % scan.nx, j = scan.next / scan.nx;
+        const float x = scan.x0 + static_cast<float>(i) * scan.step, z = scan.z0 + static_cast<float>(j) * scan.step;
+        const auto hit = local_ground_height(x, z, scan.top, scan.bottom);
+        if (!hit) ++scan.misses;
+        scan.heights[scan.next++] = hit ? *hit : std::numeric_limits<float>::quiet_NaN();
+    }
+    if (scan.next == scan.heights.size()) finish_scan(s);
+}
+
+// ---- survey -------------------------------------------------------------------------------
+bool face(const Vec3 &p, float heading) { return teleport_local_skater_heading({p[0], p[1], p[2]}, heading * 3.14159265f / 180); }
+void tick_survey(State &s, Clock::time_point now) {
+    if (!s.survey || now < s.survey->until || !level_content_active() || !trainer::telemetry().skater) return;
+    auto &v = *s.survey;
+    if (v.next >= v.places.size()) {
+        say(logging::Level::info, std::format("survey done: {} places in {:.0f} s, {} without ground found", v.places.size(),
+                                              std::chrono::duration<double>(now - v.started).count(), v.missed));
+        s.survey.reset();
+        return;
+    }
+    const auto &p = v.places[v.next];
+    if (v.phase == 0) { // a little above the ground expected there; the area loads around the skater
+        face({p[0], p[1] + 1.0f, p[2]}, 0);
+        v.phase = 1;
+        v.until = now + survey_settle;
+        return;
+    }
+    if (v.phase == 1) {
+        const auto ground = local_ground_height(p[0], p[2], p[1] + 40, p[1] - 40);
+        if (!ground) ++v.missed;
+        v.ground = ground ? *ground : p[1];
+        if (v.half > 0 && !s.scan) s.scan = scan_job(p[0] - v.half, p[2] - v.half, p[0] + v.half, p[2] + v.half, v.step, v.ground + 60, v.ground - 60);
+        v.phase = 2;
+        return;
+    }
+    if (v.phase == 2) {
+        if (s.scan) return; // the height map first
+        v.phase = 3;
+    }
+    if (v.phase == 7) {
+        ++v.next;
+        v.phase = 0;
+        return;
+    }
+    const float heading = 90.0f * static_cast<float>(v.phase - 3);
+    face({p[0], v.ground + 0.5f, p[2]}, heading);
+    say(logging::Level::info, std::format("survey {}/{} at ({:.1f}, {:.2f}, {:.1f}) facing {:.0f}", v.next + 1, v.places.size(), p[0], v.ground, p[2], heading));
+    ++v.phase;
+    v.until = now + survey_look;
+}
+
+} // namespace dingosdk::domination::detail
+
+namespace dingosdk::domination {
+using namespace detail;
+std::string scan(const std::vector<std::string> &words) {
+    // x0 z0 x1 z1 [step] [top] [bottom]
+    if (words.size() < 4 || words.size() > 7) return "usage: domination scan <x0> <z0> <x1> <z1> [step 0.25] [top 60] [bottom -40]";
+    std::array<float, 7> v{0, 0, 0, 0, .25f, 60, -40};
+    for (std::size_t n = 0; n < words.size(); ++n) {
+        const auto value = number(words[n]);
+        if (!value) return "error: not a number: " + words[n];
+        v[n] = *value;
+    }
+    const float x0 = std::min(v[0], v[2]), x1 = std::max(v[0], v[2]), z0 = std::min(v[1], v[3]), z1 = std::max(v[1], v[3]);
+    const float step = v[4], top = v[5], bottom = v[6];
+    if (!(step >= .02f && step <= 10) || !(top > bottom)) return "error: step must be 0.02 to 10 and top above bottom.";
+    // (Counted in doubles first: far-off coordinates would overflow an integer.)
+    const double cx = std::floor((static_cast<double>(x1) - x0) / step) + 1, cz = std::floor((static_cast<double>(z1) - z0) / step) + 1;
+    if (cx * cz > static_cast<double>(scan_limit)) return std::format("error: {:.0f} points; at most {}.", cx * cz, scan_limit);
+    const auto nx = static_cast<std::uint64_t>(cx), nz = static_cast<std::uint64_t>(cz);
+    auto &s = state();
+    std::lock_guard lock(s.mutex);
+    if (s.scan) return "error: a scan is running.";
+    s.scan = scan_job(x0, z0, x1, z1, step, top, bottom);
+    const auto reply = std::format("Scanning {} x {} points ({:.1f} to {:.1f}, {:.1f} to {:.1f}, step {:g}).", nx, nz, x0, x1, z0, z1, step);
+    say(logging::Level::info, reply);
+    return reply;
+}
+
+std::string teleport(const std::vector<std::string> &words) {
+    if (words.size() < 3 || words.size() > 4) return "usage: domination tp <x> <y|ground> <z> [heading]";
+    std::array<float, 4> v{};
+    for (std::size_t n = 0; n < words.size(); ++n) {
+        if (n == 1 && lower(words[n]) == "ground") { // standing on whatever is below (found once there)
+            v[n] = std::numeric_limits<float>::quiet_NaN();
+            continue;
+        }
+        const auto value = number(words[n]);
+        if (!value) return "error: not a number: " + words[n];
+        v[n] = *value;
+    }
+    auto &s = state();
+    std::lock_guard lock(s.mutex);
+    if (multiplayer_session_active() && !session_noclip_allowed()) return "error: the host has turned off teleporting.";
+    s.teleport = std::pair<Vec3, float>{{v[0], v[1], v[2]}, v[3]};
+    const auto y = std::isnan(v[1]) ? std::string("the ground") : std::format("{:g}", v[1]);
+    return std::format("Teleporting to ({:g}, {}, {:g}) facing {:g} (degrees from +z towards +x).", v[0], y, v[2], v[3]);
+}
+
+std::string survey(const std::vector<std::string> &words) {
+    auto &s = state();
+    if (words.size() == 1 && words[0] == "stop") {
+        std::lock_guard lock(s.mutex);
+        if (!s.survey) return "No survey is running.";
+        const auto done = s.survey->next;
+        s.survey.reset();
+        return std::format("Survey stopped after {} places.", done);
+    }
+    if (words.empty() || words.size() > 3) return "usage: domination survey <places file> [half size 60] [step 0.5] | stop";
+    float half = 60, step = 0.5f;
+    for (std::size_t n = 1; n < words.size(); ++n) {
+        const auto value = number(words[n]);
+        if (!value) return "error: not a number: " + words[n];
+        (n == 1 ? half : step) = *value;
+    }
+    if (half < 0 || half > 500 || !(step >= .1f && step <= 10)) return "error: half size 0 to 500, step 0.1 to 10.";
+    const double side = std::floor(2.0 * half / step) + 1;
+    if (side * side > static_cast<double>(scan_limit)) return std::format("error: {:.0f} points per place; at most {} (a bigger step, or a smaller square).", side * side, scan_limit);
+    // One place per line: x y z (y: the ground expected there); # starts a comment.
+    std::ifstream file{std::filesystem::path(words[0])};
+    if (!file) return "error: could not read " + words[0];
+    Survey v;
+    std::string line;
+    while (std::getline(file, line) && v.places.size() < 10000) {
+        if (line.empty() || line[0] == '#') continue;
+        std::array<float, 3> p{};
+        std::istringstream in(line);
+        if (in >> p[0] >> p[1] >> p[2]) v.places.push_back(p);
+    }
+    if (v.places.empty()) return "error: no places in " + words[0] + " (one \"x y z\" per line).";
+    v.half = half;
+    v.step = step;
+    v.started = Clock::now();
+    std::lock_guard lock(s.mutex);
+    if (multiplayer_session_active() && !session_noclip_allowed()) return "error: the host has turned off teleporting.";
+    if (s.survey) return "error: a survey is running (domination survey stop).";
+    const auto count = v.places.size();
+    s.survey = std::move(v);
+    const auto reply = std::format("Surveying {} places: about {:.0f} minutes.", count, count * 9.5 / 60);
+    say(logging::Level::info, reply);
+    return reply;
+}
+
+} // namespace dingosdk::domination
diff --git a/Extension/Domination/domination_wire.cpp b/Extension/Domination/domination_wire.cpp
new file mode 100644
index 0000000..b65255f
--- /dev/null
+++ b/Extension/Domination/domination_wire.cpp
@@ -0,0 +1,130 @@
+#include "domination_wire.h"
+#include <bit>
+#include <cmath>
+#include <stdexcept>
+
+namespace dingosdk::domination::wire {
+namespace {
+enum : std::uint8_t { round_type = 1, board_type = 2, teams_type = 3 };
+enum : std::uint8_t { running_action = 1, stopped_action = 2, left_action = 3 };
+constexpr std::uint8_t all_options = teams;
+
+void put(std::vector<std::uint8_t> &out, std::uint64_t v, int bytes) {
+    for (int i = 0; i < bytes; ++i) out.push_back(static_cast<std::uint8_t>(v >> (8 * i)));
+}
+struct Reader {
+    std::span<const std::uint8_t> bytes;
+    std::size_t at{};
+    bool ok = true;
+    std::uint64_t take(int count) {
+        if (at + count > bytes.size()) {
+            ok = false;
+            return 0;
+        }
+        std::uint64_t v = 0;
+        for (int i = 0; i < count; ++i) v |= static_cast<std::uint64_t>(bytes[at + i]) << (8 * i);
+        at += count;
+        return v;
+    }
+    bool done() const { return ok && at == bytes.size(); }
+};
+bool sane_score(float score) { return std::isfinite(score) && score > 0 && score <= 1e9f; }
+} // namespace
+
+bool is_domination(std::span<const std::uint8_t> bytes) noexcept { return !bytes.empty() && bytes[0] == tag; }
+std::optional<std::uint8_t> version_of(std::span<const std::uint8_t> bytes) noexcept {
+    if (bytes.size() < 2 || bytes[0] != tag) return std::nullopt;
+    return bytes[1];
+}
+
+std::vector<std::uint8_t> encode(const Message &message) {
+    std::vector<std::uint8_t> out;
+    put(out, tag, 1);
+    put(out, version, 1);
+    if (const auto *r = std::get_if<RoundMessage>(&message)) {
+        put(out, round_type, 1);
+        put(out, r->park, 4);
+        put(out, r->round, 4);
+        put(out, r->starter, 8);
+        put(out, r->running ? running_action : r->left ? left_action : stopped_action, 1);
+        put(out, r->options & all_options, 1);
+        put(out, r->duration, 2);
+        put(out, r->elapsed, 4);
+    } else if (const auto *b = std::get_if<BoardMessage>(&message)) {
+        if (b->entries.size() > max_board_entries) throw std::invalid_argument("a Domination board message has too many claims");
+        put(out, board_type, 1);
+        put(out, b->park, 4);
+        put(out, b->round, 4);
+        put(out, b->entries.size(), 2);
+        for (const auto &e : b->entries) {
+            put(out, e.spot, 1);
+            put(out, e.player, 8);
+            put(out, std::bit_cast<std::uint32_t>(e.score), 4);
+            put(out, e.ms, 4);
+        }
+    } else {
+        const auto &t = std::get<TeamsMessage>(message);
+        if (t.members.size() > max_team_entries) throw std::invalid_argument("a Domination team list is too long");
+        put(out, teams_type, 1);
+        put(out, t.park, 4);
+        put(out, t.round, 4);
+        put(out, t.members.size(), 1);
+        for (const auto &[player, team] : t.members) {
+            put(out, player, 8);
+            put(out, team, 1);
+        }
+    }
+    return out;
+}
+
+std::optional<Message> decode(std::span<const std::uint8_t> bytes) noexcept {
+    Reader in{bytes};
+    if (in.take(1) != tag || in.take(1) != version) return std::nullopt;
+    const auto type = in.take(1);
+    const auto park = static_cast<std::uint32_t>(in.take(4)), round = static_cast<std::uint32_t>(in.take(4));
+    if (!in.ok || !round) return std::nullopt;
+    if (type == round_type) {
+        RoundMessage r{park, round};
+        r.starter = in.take(8);
+        const auto action = in.take(1);
+        r.options = static_cast<std::uint8_t>(in.take(1));
+        r.duration = static_cast<std::uint16_t>(in.take(2));
+        r.elapsed = static_cast<std::uint32_t>(in.take(4));
+        if (!in.done() || !r.starter || action < running_action || action > left_action || (r.options & ~all_options) || !r.duration)
+            return std::nullopt;
+        r.running = action == running_action;
+        r.left = action == left_action;
+        return r;
+    }
+    if (type == board_type) {
+        BoardMessage b{park, round};
+        const auto count = in.take(2);
+        if (!in.ok || count > max_board_entries) return std::nullopt;
+        for (std::uint64_t i = 0; i < count; ++i) {
+            Entry e;
+            e.spot = static_cast<std::uint8_t>(in.take(1));
+            e.player = in.take(8);
+            e.score = std::bit_cast<float>(static_cast<std::uint32_t>(in.take(4)));
+            e.ms = static_cast<std::uint32_t>(in.take(4));
+            if (!in.ok || !e.player || !sane_score(e.score)) return std::nullopt;
+            b.entries.push_back(e);
+        }
+        if (!in.done()) return std::nullopt;
+        return b;
+    }
+    if (type == teams_type) {
+        TeamsMessage t{park, round};
+        const auto count = in.take(1);
+        if (!in.ok || count > max_team_entries) return std::nullopt;
+        for (std::uint64_t i = 0; i < count; ++i) {
+            const auto player = in.take(8);
+            const auto team = in.take(1);
+            if (!in.ok || !player || team > 1) return std::nullopt;
+            t.members.emplace_back(player, static_cast<std::uint8_t>(team));
+        }
+        if (!in.done()) return std::nullopt;
+        return t;
+    }
+    return std::nullopt;
+}
+}
diff --git a/Extension/Domination/domination_wire.h b/Extension/Domination/domination_wire.h
new file mode 100644
index 0000000..2d67dc1
--- /dev/null
+++ b/Extension/Domination/domination_wire.h
@@ -0,0 +1,62 @@
+#pragma once
+#include <cstdint>
+#include <optional>
+#include <span>
+#include <utility>
+#include <variant>
+#include <vector>
+
+// Domination's messages between players. They ride in the session's throwdown packets
+// (PacketKind::throwdown, relayed opaque by hosts and dedicated servers to the same map and
+// world), told apart from the throwdown relay's own messages by their first byte: the relay's
+// kinds are 1-15, Domination's tag is 0xD0. The session hands them to Domination before the
+// relay sees them (Extension/Multiplayer/Session/session.cpp). The sender is the packet's source.
+//
+// Little-endian: u8 tag 0xD0, u8 version, u8 type, u32 park, u32 round, then by type:
+// - round (1): u64 starter, u8 action (1 running, 2 stopped, 3 the sender left it), u8 options (1 teams),
+//   u16 duration (s), u32 elapsed (ms, as the sender timed it);
+// - board (2): u16 count, then count claims: u8 spot, u64 player, f32 score, u32 ms (since the
+//   round started, as the claimant timed it); at most max_board_entries;
+// - teams (3): u8 count, then count of: u64 player, u8 team (0 or 1).
+// Every participant sends the whole board it knows every few seconds, so a player who arrives
+// late, or missed a message, ends up with the same board as everyone else.
+namespace dingosdk::domination::wire {
+inline constexpr std::uint8_t tag = 0xD0, version = 4;
+inline constexpr std::size_t max_board_entries = 200, max_team_entries = 64;
+enum Option : std::uint8_t { teams = 1 };
+struct RoundMessage {
+    std::uint32_t park{}, round{};
+    std::uint64_t starter{};
+    bool running{};
+    std::uint8_t options{};
+    std::uint16_t duration{}; // seconds to play (the countdown not counted)
+    std::uint32_t elapsed{};  // ms since it started, as the sender timed it (stopped or left: when)
+    bool left{};              // not running: the sender left it (it goes on for the others); else it was stopped
+    bool operator==(const RoundMessage &) const = default;
+};
+struct Entry {
+    std::uint8_t spot{};
+    std::uint64_t player{};
+    float score{};
+    std::uint32_t ms{};
+    bool operator==(const Entry &) const = default;
+};
+struct BoardMessage {
+    std::uint32_t park{}, round{};
+    std::vector<Entry> entries;
+    bool operator==(const BoardMessage &) const = default;
+};
+struct TeamsMessage {
+    std::uint32_t park{}, round{};
+    std::vector<std::pair<std::uint64_t, std::uint8_t>> members;
+    bool operator==(const TeamsMessage &) const = default;
+};
+using Message = std::variant<RoundMessage, BoardMessage, TeamsMessage>;
+bool is_domination(std::span<const std::uint8_t> bytes) noexcept;
+// The version a Domination message was written in (to tell a player on another build), if any.
+std::optional<std::uint8_t> version_of(std::span<const std::uint8_t> bytes) noexcept;
+// Throws std::invalid_argument for a board or team list longer than its limit.
+std::vector<std::uint8_t> encode(const Message &message);
+// Empty for anything malformed, of another version, or not Domination's.
+std::optional<Message> decode(std::span<const std::uint8_t> bytes) noexcept;
+}
