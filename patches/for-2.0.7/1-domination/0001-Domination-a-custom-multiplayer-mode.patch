--- /dev/null
+++ b/Extension/Domination/domination_files.cpp
@@ -0,0 +1,363 @@
+#include "domination_internal.h"
+#include "domination_parks.h"
+#include "Engine/Core/Platform/memory.h"
+#include "Engine/Vfs/mod_list.h"
+#include "Extension/Profile/local_profile_runtime.h"
+#include "Extension/World/level_loading.h"
+#include <Windows.h>
+#include <ShlObj.h>
+#include <algorithm>
+#include <cctype>
+#include <charconv>
+#include <ctime>
+#include <format>
+#include <iterator>
+
+// Park files and the spots' outlines on the ground (domination_internal.h).
+namespace dingosdk::domination::detail {
+// ---- files ------------------------------------------------------------------------------
+// <LOCALAPPDATA>\ReSkate\domination: the variable first, so a copy started with its own
+// LOCALAPPDATA keeps its files apart.
+std::filesystem::path data_directory() {
+    std::vector<wchar_t> variable(32768);
+    const auto length = GetEnvironmentVariableW(L"LOCALAPPDATA", variable.data(), static_cast<DWORD>(variable.size()));
+    std::filesystem::path root;
+    if (length && length < variable.size()) root = variable.data();
+    else {
+        PWSTR raw{};
+        if (SUCCEEDED(SHGetKnownFolderPath(FOLDERID_LocalAppData, 0, nullptr, &raw)) && raw) root = raw;
+        if (raw) CoTaskMemFree(raw);
+    }
+    return root.empty() ? root : root / L"ReSkate" / L"domination";
+}
+std::string stamp() {
+    const auto now = std::time(nullptr);
+    std::tm local{};
+    localtime_s(&local, &now);
+    char text[32]{};
+    std::strftime(text, sizeof text, "%Y%m%d-%H%M%S", &local);
+    return text;
+}
+std::filesystem::path game_directory() {
+    std::vector<wchar_t> exe(32768);
+    const auto length = GetModuleFileNameW(nullptr, exe.data(), static_cast<DWORD>(exe.size()));
+    if (!length || length >= exe.size()) return {};
+    return std::filesystem::path(exe.data()).parent_path();
+}
+std::optional<Json> read_json(const std::filesystem::path &path) {
+    try {
+        std::ifstream file(path, std::ios::binary);
+        if (!file) return std::nullopt;
+        const std::string text((std::istreambuf_iterator<char>(file)), std::istreambuf_iterator<char>());
+        if (text.empty() || text.size() > 4 * 1024 * 1024) return std::nullopt;
+        return Json::parse(text);
+    } catch (...) {
+        return std::nullopt;
+    }
+}
+std::string lower(std::string value) {
+    std::ranges::transform(value, value.begin(), [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+    return value;
+}
+std::string points(float score) {
+    auto digits = std::to_string(static_cast<long long>(std::llround(score)));
+    for (int at = static_cast<int>(digits.size()) - 3; at > 0; at -= 3) digits.insert(static_cast<std::size_t>(at), ",");
+    return digits;
+}
+void say(logging::Level level, const std::string &text) { logging::write(level, logging::Channel::world, "Domination: " + text); }
+
+std::optional<float> number(const std::string &word) {
+    float value{};
+    const auto *end = word.data() + word.size();
+    const auto [at, error] = std::from_chars(word.data(), end, value);
+    if (error != std::errc{} || at != end || !std::isfinite(value)) return std::nullopt;
+    return value;
+}
+void toast(State &s, std::string text, int kind, Player who) {
+    s.toasts.push_back({std::move(text), kind, Clock::now() + std::chrono::milliseconds(static_cast<int>(toast_shown * 1000)), who});
+    while (s.toasts.size() > 4) s.toasts.pop_front();
+}
+
+// ---- park files -------------------------------------------------------------------------
+std::vector<std::filesystem::path> park_files() {
+    std::vector<std::filesystem::path> files;
+    std::error_code error;
+    const auto own = data_directory() / L"parks";
+    for (std::filesystem::directory_iterator it(own, error), end; it != end && !error; it.increment(error))
+        if (it->path().extension() == L".json") files.push_back(it->path());
+    // Mods switched on in the launcher, highest priority first: domination*.json beside the mod's
+    // manifest (a map mod shipping its parks), and every .json in its domination folder (a pack of
+    // parks, a mod of nothing else).
+    const auto list = mods::scan_mods(game_directory());
+    for (const auto &entry : list.entries) {
+        if (!entry.enabled || !entry.mod.outdated.empty()) continue;
+        std::error_code inner;
+        for (std::filesystem::directory_iterator file(entry.mod.directory, inner), last; file != last && !inner; file.increment(inner)) {
+            const auto name = lower(file->path().filename().string());
+            if (name.starts_with("domination") && name.ends_with(".json")) files.push_back(file->path());
+        }
+        for (std::filesystem::directory_iterator file(entry.mod.directory / L"domination", inner), last; file != last && !inner; file.increment(inner))
+            if (lower(file->path().extension().string()) == ".json") files.push_back(file->path());
+    }
+    return files;
+}
+// The park for `level`, from the first file that names it and reads cleanly.
+// Every park there is: the files (a parks folder, map mods) first, then the ones built in, which
+// a file of the same name overrides. Each with where it came from, for the log.
+struct ParkSource {
+    std::string id, where;
+    Json json;
+};
+std::vector<ParkSource> park_sources() {
+    std::vector<ParkSource> sources;
+    for (const auto &path : park_files())
+        if (auto json = read_json(path); json && json->is_object())
+            sources.push_back({path.stem().string(), path.string(), std::move(*json)});
+    for (const auto &builtin : builtin_parks) {
+        if (std::ranges::any_of(sources, [&](const ParkSource &source) { return source.id == builtin.id; })) continue;
+        try {
+            sources.push_back({std::string(builtin.id), "built in", Json::parse(builtin.json)});
+        } catch (const std::exception &error) {
+            say(logging::Level::warning, std::format("built-in park {} unreadable: {}", builtin.id, error.what()));
+        }
+    }
+    return sources;
+}
+bool names_level(const Json &json) { return json.contains("level") && json.at("level").is_string(); }
+
+std::uint32_t park_hash(const Park &park) {
+    std::uint32_t h = 2166136261u;
+    const auto mix = [&](std::string_view text) {
+        for (const unsigned char c : text) h = (h ^ c) * 16777619u;
+        h = (h ^ 0x0a) * 16777619u;
+    };
+    mix(park.level);
+    for (const auto &spot : park.spots) mix(spot.id);
+    return h;
+}
+void scan_parks(State &s) {
+    s.parks.clear();
+    s.park_problems.clear();
+    for (const auto &source : park_sources()) {
+        if (!names_level(source.json)) continue;
+        try {
+            auto park = parse_park(source.json);
+            const auto hash = park_hash(park);
+            s.parks.push_back({source.id, source.where, std::move(park), hash});
+        } catch (const std::exception &error) {
+            s.park_problems.emplace_back(lower(source.json.at("level").string()), source.id + ": " + error.what());
+        }
+    }
+}
+const KnownPark *find_park(const State &s, std::string_view id) {
+    const auto it = std::ranges::find_if(s.parks, [&](const KnownPark &k) { return k.id == id; });
+    return it == s.parks.end() ? nullptr : &*it;
+}
+const KnownPark *next_park(const State &s) {
+    if (const auto *chosen = find_park(s, s.chosen)) return chosen;
+    // Unpicked: the red-bowl park, the first Domination park, when its map is here.
+    if (const auto *park = find_park(s, default_park)) {
+        const auto state = map_state(s, park->park);
+        if (state != MapState::missing && state != MapState::off) return park;
+    }
+    if (!s.level.empty())
+        for (const auto &k : s.parks)
+            if (k.park.level == s.level) return &k;
+    return s.parks.empty() ? nullptr : &s.parks.front();
+}
+std::string map_name(const Park &park) {
+    if (!park.map.empty()) return park.map;
+    const auto slash = park.level.find_last_of('/');
+    return slash == std::string::npos ? park.level : park.level.substr(slash + 1);
+}
+// Whether each park's map can be played here, from the Mods folder (read at most every
+// map_check_every: the menu asks a few times a second). A park with no package is on the game's own map.
+void check_maps(State &s, Clock::time_point now) {
+    if (now < s.next_map_check && !s.maps.empty()) return;
+    s.next_map_check = now + map_check_every;
+    s.maps.clear();
+    const auto list = mods::scan_mods(game_directory());
+    for (const auto &k : s.parks) {
+        auto &state = s.maps[k.park.level];
+        if (state == MapState::installed) continue;
+        if (k.park.package.empty()) {
+            state = MapState::installed;
+            continue;
+        }
+        auto found = MapState::missing;
+        for (const auto &entry : list.entries) {
+            const bool level = std::ranges::any_of(entry.mod.levels, [&](const std::string &asset) { return lower(asset) == k.park.level; });
+            if (!level && lower(entry.mod.name) != lower(k.park.package)) continue;
+            if (entry.enabled && entry.mod.outdated.empty()) {
+                found = MapState::installed;
+                break;
+            }
+            found = MapState::off;
+        }
+        state = found;
+    }
+}
+MapState map_state(const State &s, const Park &park) {
+    if (park.level == s.level) return MapState::installed;
+    const auto it = s.maps.find(park.level);
+    return it == s.maps.end() ? MapState::unknown : it->second;
+}
+// ---- spot outlines ----------------------------------------------------------------------
+// Points along a spot's edge seen from above, about half a metre apart (what a wall hides is cut
+// out that finely), going round it once.
+std::vector<Vec2> perimeter(const Spot &spot) {
+    constexpr float step = 0.5f, pi = 3.14159265f;
+    std::vector<Vec2> points;
+    const auto line = [&](Vec2 a, Vec2 b) {
+        const float dx = b[0] - a[0], dz = b[1] - a[1];
+        const int n = std::max(1, static_cast<int>(std::ceil(std::hypot(dx, dz) / step)));
+        for (int k = 0; k < n; ++k) points.push_back({a[0] + dx * k / n, a[1] + dz * k / n});
+    };
+    // Half a circle about `c`, from the angle `from` (about world up, from +x towards +z) on by pi.
+    const auto arc = [&](Vec2 c, float from, float r) {
+        const int n = std::max(6, static_cast<int>(std::ceil(pi * r / step)));
+        for (int k = 0; k < n; ++k) {
+            const float a = from + pi * k / n;
+            points.push_back({c[0] + r * std::cos(a), c[1] + r * std::sin(a)});
+        }
+    };
+    if (!spot.capsule) {
+        for (std::size_t i = 0; i < spot.points.size(); ++i) line(spot.points[i], spot.points[(i + 1) % spot.points.size()]);
+    } else {
+        const auto &a = spot.a, &b = spot.b;
+        const float r = spot.radius, angle = std::atan2(b[1] - a[1], b[0] - a[0]);
+        const Vec2 n{-std::sin(angle) * r, std::cos(angle) * r}; // the side at angle + pi/2
+        line({a[0] - n[0], a[1] - n[1]}, {b[0] - n[0], b[1] - n[1]});
+        arc(b, angle - pi / 2, r);
+        line({b[0] + n[0], b[1] + n[1]}, {a[0] + n[0], a[1] + n[1]});
+        arc(a, angle + pi / 2, r);
+    }
+    constexpr std::size_t most = 800;
+    if (points.size() > most) {
+        std::vector<Vec2> fewer;
+        for (std::size_t i = 0; i < most; ++i) fewer.push_back(points[i * points.size() / most]);
+        points = std::move(fewer);
+    }
+    return points;
+}
+void begin_outlines(State &s) {
+    s.outlines.clear();
+    s.outline_since.clear();
+    s.outline_retry.clear();
+    s.outline_seen.clear();
+    s.outline_shown.clear();
+    s.sight_cursor = 0;
+    s.outline_left = 0;
+    if (!s.park) return;
+    for (const auto &spot : s.park->spots) {
+        auto &outline = s.outlines.emplace_back();
+        for (const auto &p : perimeter(spot)) outline.push_back({p[0], std::numeric_limits<float>::quiet_NaN(), p[1]});
+        s.outline_left += outline.size();
+        s.outline_since.push_back({});
+        s.outline_retry.push_back({});
+        s.outline_seen.emplace_back(outline.size(), std::uint8_t{});
+        s.outline_shown.emplace_back(outline.size(), 0.0f);
+    }
+}
+// The heights still unknown, a few at a time, for the spots near the skater only: the ground
+// under each point within its spot's height range. Collision streams in around the skater (a ray
+// far from them hits nothing), so misses are tried again four times a second; points still missing
+// 5 s after the spot's latest hit, the skater near all along (inside a wall: a ray that starts in a
+// solid hits nothing), are filled in from the points either side. A spot never hit is not drawn.
+void tick_outlines(State &s, const Vec3 &skater) {
+    if (!s.park || !s.outline_left || s.outlines.size() != s.park->spots.size() || s.outline_since.size() != s.outlines.size() ||
+        s.outline_retry.size() != s.outlines.size())
+        return;
+    constexpr float within = 120; // m from the skater to a spot's marker, seen from above
+    constexpr auto most = std::chrono::seconds(5);
+    const auto now = Clock::now();
+    const auto until = now + std::chrono::milliseconds(2);
+    const std::size_t spots = s.outlines.size(), first = s.outline_turn++ % spots; // each spot first in turn
+    for (std::size_t n = 0; n < spots; ++n) {
+        const std::size_t i = (first + n) % spots;
+        const auto &spot = s.park->spots[i];
+        auto &outline = s.outlines[i];
+        const auto unknown = [](const Vec3 &p) { return std::isnan(p[1]); };
+        if (std::ranges::none_of(outline, unknown)) continue;
+        if (std::hypot(spot.marker[0] - skater[0], spot.marker[2] - skater[2]) > within) {
+            s.outline_since[i] = {}; // away: the 5 s start again from a hit once back
+            continue;
+        }
+        if (now < s.outline_retry[i]) continue;
+        bool missed = false;
+        for (auto &p : outline) {
+            if (!unknown(p)) continue;
+            if (Clock::now() >= until) return;
+            if (const auto ground = local_ground_height(p[0], p[2], spot.y_max + 0.5f, spot.y_min - 2.0f)) {
+                p[1] = *ground;
+                --s.outline_left;
+                s.outline_since[i] = now;
+            } else
+                missed = true;
+        }
+        if (missed && (s.outline_since[i] == Clock::time_point{} || now - s.outline_since[i] < most)) {
+            s.outline_retry[i] = now + std::chrono::milliseconds(250);
+            continue;
+        }
+        // All its heights known, or as many as will be: the rest filled in, and one or two points
+        // off the top of a wall or a rail evened out.
+        std::vector<float> heights;
+        for (const auto &p : outline) heights.push_back(p[1]);
+        s.outline_left -= static_cast<std::size_t>(std::ranges::count_if(outline, unknown));
+        fill_in(heights, spot.y_min);
+        even_out(heights);
+        for (std::size_t k = 0; k < outline.size(); ++k) outline[k][1] = heights[k];
+        if (!s.outline_left) say(logging::Level::info, "spot outlines measured");
+    }
+}
+
+// What the camera can see of the outlines near the skater, a few points a tick in turn: a ray from
+// the camera to each point (a little above the ground) that reaches it, or stops within half a
+// metre of it, sees it. Walls, ramps and the bowls' lips hide what is behind them; the skater
+// does not (a ray stopped by them sees the point).
+void tick_sight(State &s, const Vec3 &skater) {
+    if (!s.park || s.outline_seen.size() != s.outlines.size() || Clock::now() - s.camera_at > std::chrono::milliseconds(500)) return;
+    std::size_t total = 0;
+    for (const auto &outline : s.outlines) total += outline.size();
+    if (!total) return;
+    const auto until = Clock::now() + std::chrono::microseconds(1500);
+    for (std::size_t done = 0; done < total && Clock::now() < until; ++done) {
+        std::size_t at = s.sight_cursor++ % total, i = 0;
+        while (at >= s.outlines[i].size()) at -= s.outlines[i++].size();
+        const auto &p = s.outlines[i][at];
+        auto &seen = s.outline_seen[i][at];
+        if (std::isnan(p[1]) || std::hypot(p[0] - skater[0], p[2] - skater[2]) > outline_far + 4) {
+            seen = 0;
+            continue;
+        }
+        const Vec3 target{p[0], p[1] + 0.2f, p[2]};
+        const auto hit = local_surface_hit({s.camera[0], s.camera[1], s.camera[2]}, {target[0], target[1], target[2]});
+        seen = !hit || std::hypot((*hit)[0] - target[0], (*hit)[1] - target[1], (*hit)[2] - target[2]) < 0.5f ||
+               std::hypot((*hit)[0] - skater[0], (*hit)[1] - skater[1], (*hit)[2] - skater[2]) < 1.6f;
+    }
+}
+
+void use_park(State &s, const KnownPark &k) {
+    s.park = k.park;
+    s.park_id = k.id;
+    s.park_problem.clear();
+    say(logging::Level::info, std::format("park \"{}\" ({} spots, {} starts) from {}", k.park.name, k.park.spots.size(), k.park.starts.size(), k.where));
+    begin_outlines(s);
+}
+void load_park(State &s) {
+    scan_parks(s);
+    s.park.reset();
+    s.park_id.clear();
+    s.park_problem.clear();
+    begin_outlines(s);
+    for (const auto &[level, problem] : s.park_problems) say(logging::Level::warning, "park refused, " + problem);
+    if (s.level.empty()) return;
+    // The chosen park when it is on this map, else this map's first.
+    const auto *k = next_park(s);
+    if (k && k->park.level == s.level) use_park(s, *k);
+    else
+        for (const auto &[level, problem] : s.park_problems)
+            if (level == s.level) s.park_problem = problem; // why this map has none
+}
+
+} // namespace dingosdk::domination::detail
diff --git a/Extension/Domination/domination_hud.cpp b/Extension/Domination/domination_hud.cpp
new file mode 100644
index 0000000..2ff2899
--- /dev/null
+++ b/Extension/Domination/domination_hud.cpp
@@ -0,0 +1,80 @@
+#include "domination_internal.h"
+#include "Engine/Core/Platform/memory.h"
+#include "Engine/Game/Abi/native_data.h"
+#include "Engine/Game/Build/addresses.h"
+#include "Engine/Game/Build/20260929/engine.h"
+#include "Engine/Game/Build/20260929/hud_corner.h"
+#include <algorithm>
+#include <format>
+
+// Tricks read from skate.'s score HUD view model (domination_internal.h).
+namespace dingosdk::domination::detail {
+// ---- reading the score HUD --------------------------------------------------------------
+// Runs `use(context)` on the game's UI model registry under its model lock (as Hall of Meat's
+// HUD code does). False while there is no registry.
+template <class Use> bool with_ui_models(Address base, Use &&use) {
+    if (!base) return false;
+    const auto ui = menu_data::read<Address>(base + addr::engine::ui_manager);
+    const auto manager = ui ? menu_data::read<Address>(ui + 0x140) : 0;
+    if (!manager) return false;
+    const menu_data::Context context(base, manager);
+    game::ModelWriteLock lock(manager);
+    use(context);
+    return true;
+}
+bool bind_model(Hud &h, const menu_data::Context &context) {
+    if (h.manager != context.manager) {
+        h.manager = context.manager;
+        h.model = {};
+    }
+    if (h.model.handle && context.type_of(h.model.handle) == h.model.type) return true;
+    h.model = {};
+    const auto now = Clock::now();
+    if (now < h.next_look) return false;
+    h.next_look = now + std::chrono::seconds(1);
+    const auto roots = context.roots({addr::hud_corner::score_view_schema});
+    if (roots.empty()) return false;
+    const auto model = roots.front().model;
+    std::string layout;
+    for (std::size_t n = 0; n < watched.size(); ++n) {
+        auto &field = h.fields[n];
+        field = {};
+        try {
+            const auto member = context.member(model.type, watched[n].hash);
+            field.present = true;
+            field.offset = member.offset;
+            field.size = menu_data::size(member.type);
+            field.kind = menu_data::kind(member.type);
+            layout += std::format(" {}@+0x{:x}:{}b/k{}", watched[n].name, field.offset, field.size, field.kind);
+        } catch (const std::exception &) {
+            layout += std::format(" {}:missing", watched[n].name);
+        }
+    }
+    h.model = model;
+    say(logging::Level::info, "found the score HUD model:" + layout);
+    return true;
+}
+// Reads every watched field into `now`. False without the model.
+bool read_hud(State &s) {
+    auto &h = s.hud;
+    bool ok = false;
+    try {
+        with_ui_models(s.base, [&](const menu_data::Context &context) {
+            if (!bind_model(h, context)) return;
+            const auto at = context.address(h.model);
+            for (auto &field : h.fields) {
+                field.read = field.present && memory::peek_bytes(at + field.offset, field.now.data(), std::min<unsigned>(field.size, value_bytes));
+            }
+            ok = true;
+        });
+        h.warned = false;
+    } catch (const std::exception &error) {
+        h.model = {};
+        if (!std::exchange(h.warned, true)) say(logging::Level::warning, std::string("cannot read the score HUD: ") + error.what());
+    } catch (...) {
+        h.model = {};
+    }
+    return ok;
+}
+
+} // namespace dingosdk::domination::detail
diff --git a/Extension/Domination/domination_internal.h b/Extension/Domination/domination_internal.h
new file mode 100644
index 0000000..b6d2e49
--- /dev/null
+++ b/Extension/Domination/domination_internal.h
@@ -0,0 +1,287 @@
+#pragma once
+// Domination's game side, shared by its files. Not for other code: domination.h is the API.
+// - domination.cpp: rounds (the game around domination_sync.h's rules), the console, the menu's
+//   snapshot and the overlay's view;
+// - domination_files.cpp: park files, the spots' outlines on the ground;
+// - domination_hud.cpp: tricks read from skate.'s score HUD;
+// - domination_tools.cpp: park-making (scan, tp, survey).
+// The rules themselves are apart from the game: domination_model.h (parks, spots, reading
+// tricks, the board, a round's results), domination_sync.h (multiplayer rounds) and
+// domination_wire.h (the messages).
+#include "domination.h"
+#include "domination_model.h"
+#include "domination_sync.h"
+#include "Engine/Core/Json/json.h"
+#include "Engine/Core/Log/logging.h"
+#include "Extension/Trainer/trainer.h"
+#include "Extension/UI/NativeMenu/native_menu_data.h"
+#include <array>
+#include <chrono>
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+#include <deque>
+#include <filesystem>
+#include <fstream>
+#include <limits>
+#include <map>
+#include <mutex>
+#include <optional>
+#include <set>
+#include <string>
+#include <vector>
+
+namespace dingosdk::domination::detail {
+namespace menu_data = multiplayer::menu_data;
+using Address = std::uintptr_t;
+using Clock = std::chrono::steady_clock;
+
+constexpr double default_round = 300;  // seconds
+constexpr double results_shown = 12;    // seconds after a round (gone sooner once the skater rides off)
+constexpr double toast_shown = 4;
+
+// ---- the score HUD ----------------------------------------------------------------------
+// ScoringHUDViewModel's fields, by the hashes of their names in the game's own type data
+// (ui/features/hud/scoring/ScoringHUDViewModel; HudWidgetActive 0x3aa2f739 and ExtraInfoStyle
+// 0x0426783f are the ones hud_corner.h already uses). The round reads these four.
+struct Watched {
+    const char *name;
+    std::uint32_t hash;
+};
+enum : std::size_t { line_score, is_slam, multiplier, action_active };
+constexpr std::array<Watched, 4> watched{{
+    {"LineScore", 1086322279u},
+    {"IsSlam", 2943226809u},
+    {"Multiplier", 1782700230u},
+    {"ActionActive", 2058053468u},
+}};
+constexpr std::size_t value_bytes = 16; // read per field
+
+struct Bound {
+    bool present{};
+    std::uint16_t offset{};
+    unsigned size{}, kind{};
+    std::array<unsigned char, value_bytes> now{};
+    bool read{};
+};
+struct Hud {
+    Clock::time_point next_look;
+    Address manager{};
+    menu_data::Value model;
+    std::array<Bound, watched.size()> fields{};
+    bool warned{};
+    bool blind_told{}; // a round has been told that tricks can't be read (this build of the game)
+};
+
+// A score field's value: the game's widget logic keeps scores as floats (kind 19, as LineTimer
+// and Multiplier); an integer reading is taken if the float one is not sensible.
+inline float score_of(const Bound &field) {
+    if (!field.present || !field.read || field.size != 4) return 0;
+    float f{};
+    std::int32_t i{};
+    std::memcpy(&f, field.now.data(), 4);
+    std::memcpy(&i, field.now.data(), 4);
+    if (std::isfinite(f) && (f == 0 || (std::abs(f) > 1e-3f && std::abs(f) < 1e9f))) return f;
+    return static_cast<float>(i);
+}
+inline bool flag_of(const Bound &field) { return field.present && field.read && field.now[0] != 0; }
+
+// ---- the round --------------------------------------------------------------------------
+// The rounds themselves (who runs them, joining, the clock, teams, the board, the results) are
+// domination_sync.h's, one Node per park. Here is what the game adds: tricks read from the score
+// HUD, the skater put at a start, and what the player sees and hears.
+using sync::Ms;
+struct Toast {
+    std::string text;
+    int kind{};
+    Clock::time_point until;
+    Player who{}; // the player it is about (another player's claim): drawn in their colour
+};
+// A spot's marker flashes this long when its owner changes.
+constexpr double flash_seconds = 1.2;
+// Edge arrows point at this many of the nearest spots you do not own.
+constexpr std::size_t arrows_shown = 6;
+inline Ms ms_of(Clock::time_point t) { return std::chrono::duration_cast<std::chrono::milliseconds>(t.time_since_epoch()).count(); }
+
+// What the game keeps beside the node's round: one per round (by its number).
+struct Play {
+    std::uint32_t round{};
+    TrickWatch watch;
+    std::vector<Clock::time_point> flashed; // when each spot's owner last changed
+    int start = -1;                         // this player's start (Park::starts), -1 none
+    bool place{};                           // the skater is still to be put at it
+    bool done{};                            // its end handled: results up
+    bool counted{};                         // in this player's round counts (Stats)
+    int beat = -1;                          // the countdown's last number heard (3, 2, 1; 0 GO)
+};
+// The countdown as shown and heard: 3 (the first two seconds, while the skaters are placed), 2,
+// 1, then 0 (GO) the moment tricks start to count. -1 after.
+inline int countdown_beat(Ms played) {
+    if (played >= sync::countdown_ms + 1200) return -1;
+    if (played >= sync::countdown_ms) return 0;
+    return std::min(3, static_cast<int>((sync::countdown_ms - played + 999) / 1000));
+}
+// A round asked for on another map: it starts once that map has loaded and the skater has stood
+// in it for a moment.
+struct Pending {
+    std::string level, name;
+    double duration{};
+    bool solo{};
+    Clock::time_point asked, skater_since;
+};
+constexpr auto pending_patience = std::chrono::minutes(4);
+constexpr auto settle_after_load = std::chrono::seconds(3);
+// In a session the other players load the map after the host: a round started from another map
+// waits this long for them (one still loading joins the round when they arrive).
+constexpr auto settle_in_session = std::chrono::seconds(10);
+
+// ---- scan -------------------------------------------------------------------------------
+// One downward ray per grid point, x fastest; heights in world metres, NaN where nothing was hit.
+// File: "DOMSCAN1", u32 nx, u32 nz, f32 x0, z0, step, top, bottom, then nx*nz f32.
+struct Scan {
+    float x0{}, z0{}, step{}, top{}, bottom{};
+    std::uint32_t nx{}, nz{};
+    std::vector<float> heights;
+    std::size_t next{}, misses{};
+    Clock::time_point started;
+};
+inline constexpr auto scan_budget = std::chrono::milliseconds(6); // of each client tick
+constexpr std::size_t scan_limit = 8'000'000;              // points
+inline Scan scan_job(float x0, float z0, float x1, float z1, float step, float top, float bottom) {
+    const auto nx = static_cast<std::uint32_t>(std::floor((x1 - x0) / step)) + 1, nz = static_cast<std::uint32_t>(std::floor((z1 - z0) / step)) + 1;
+    Scan job{x0, z0, step, top, bottom, nx, nz};
+    job.heights.assign(static_cast<std::size_t>(nx) * nz, std::numeric_limits<float>::quiet_NaN());
+    job.started = Clock::now();
+    return job;
+}
+
+// ---- survey -------------------------------------------------------------------------------
+// A walk through a list of places, for finding and making parks (`domination survey`). At each
+// place the skater is put there and waits for the area to load (the game loads collision only
+// around the skater); the ground is found; a height map of the square around it is written (as
+// `domination scan`); then the skater faces north (+z), east (+x), south and west in turn, each
+// pose logged with its time, for pictures of the game's window taken alongside.
+struct Survey {
+    std::vector<std::array<float, 3>> places;
+    std::size_t next{}, missed{};
+    float half{}, step{}; // the height map's half size and step (half 0: none)
+    int phase{};          // 0 arrive, 1 look for the ground, 2 the height map, 3-6 the four headings
+    float ground{};
+    Clock::time_point until, started;
+};
+constexpr auto survey_settle = std::chrono::seconds(3);
+constexpr auto survey_look = std::chrono::milliseconds(1500);
+
+// Every park there is (the files, then the ones built in), whatever map is loaded.
+struct KnownPark {
+    std::string id; // the file's name without .json
+    std::string where;
+    Park park;
+    std::uint32_t hash{};
+};
+// Whether a park's map can be played here: the game's own, or a map mod installed and switched on.
+using MapState = MapStatus;
+constexpr auto map_check_every = std::chrono::seconds(10);
+// The rounds this player has played to the end, saved with their profile ("ReSkate.Domination.*"):
+// in all, with other players, won with them, and per park (by id). Read once the profile is there.
+struct Stats {
+    bool loaded{};
+    int rounds{}, online{}, won{};
+    std::map<std::string, int, std::less<>> parks;
+};
+
+struct State {
+    std::mutex mutex;
+    Address base{};
+    std::string level;
+    std::optional<Park> park;
+    std::string park_id; // the loaded park's (a KnownPark's id)
+    std::string park_problem;
+    std::uint32_t park_hash{}; // the same park on every player's side: its level and spot ids
+    std::vector<KnownPark> parks;
+    std::vector<std::pair<std::string, std::string>> park_problems; // park files refused: level, "<id>: why"
+    // The park the next round is played in (`domination set park`): empty, this map's first park.
+    std::string chosen;
+    std::map<std::string, MapState> maps; // per level (lower case), checked every map_check_every
+    Clock::time_point next_map_check{};
+    // The next round's settings (`domination set`, or a menu through it).
+    int next_duration = static_cast<int>(default_round);
+    bool next_solo{};
+    bool next_teams{}; // free-for-all by default
+    std::optional<sync::Node> node; // this map's park's rounds
+    std::optional<Play> play;
+    std::optional<Pending> pending;
+    std::map<Player, std::string> names; // players' names (the session's roster)
+    std::vector<std::vector<std::uint8_t>> outgoing; // messages for the session to send
+    Clock::time_point next_roster;
+    Clock::time_point results_until;
+    std::deque<Toast> toasts;
+    Clock::time_point last_tick;
+    Vec3 position{};
+    bool skater{};
+    int here = -1;
+    Hud hud;
+    std::optional<Scan> scan;
+    std::string last_scan; // the last finished scan's file, or why it failed
+    // `domination tp`: a teleport facing a heading (degrees), done at the next client tick.
+    std::optional<std::pair<Vec3, float>> teleport;
+    std::optional<Survey> survey;
+    // The spots' outlines on the ground: points along their edges about half a metre apart, each one's
+    // height found by a ray once the skater is near (collision streams in around them; client
+    // thread, a little each tick). A spot's outline is drawn once all its heights are known.
+    std::vector<std::vector<Vec3>> outlines;
+    std::vector<Clock::time_point> outline_since; // per spot: its latest ground hit, the skater near since
+    std::vector<Clock::time_point> outline_retry; // per spot: its misses tried again from then
+    std::size_t outline_turn{};                   // the spot measured first on the next tick
+    // What the camera can see of the outlines near the skater: per point, whether a ray from the
+    // camera reaches it (found a few at a time), and how much of it is drawn (easing to that).
+    std::vector<std::vector<std::uint8_t>> outline_seen;
+    std::vector<std::vector<float>> outline_shown;
+    std::size_t sight_cursor{};
+    Vec3 camera{};
+    Clock::time_point camera_at{}, shown_at{};
+    std::size_t outline_left{};
+    Stats stats;
+};
+// The one state, behind its mutex (domination.cpp).
+State &state();
+
+// ---- shared helpers (domination_files.cpp) --------------------------------------------------
+std::filesystem::path data_directory();
+std::filesystem::path game_directory();
+std::optional<Json> read_json(const std::filesystem::path &path);
+std::string lower(std::string value);
+std::string points(float score);
+void say(logging::Level level, const std::string &text);
+std::optional<float> number(const std::string &word);
+void toast(State &s, std::string text, int kind, Player who = 0);
+// Park files.
+void scan_parks(State &s);
+// The loaded map's park: the chosen one when it is on this map, else the map's first.
+void load_park(State &s);
+// Makes `park` the loaded one (it must be on the loaded map).
+void use_park(State &s, const KnownPark &park);
+std::uint32_t park_hash(const Park &park);
+const KnownPark *find_park(const State &s, std::string_view id);
+// The park a round is played in until another is picked (when its map is here).
+inline constexpr std::string_view default_park = "skate3improved-redbowl";
+// The park the next round is played in: the chosen one, else default_park, else this map's first,
+// else the first.
+const KnownPark *next_park(const State &s);
+// The park's map as players know it.
+std::string map_name(const Park &park);
+void check_maps(State &s, Clock::time_point now);
+MapState map_state(const State &s, const Park &park);
+void tick_outlines(State &s, const Vec3 &skater);
+// Outlines are drawn near the skater only, fading out between these (m, seen from above).
+inline constexpr float outline_near = 18, outline_far = 32;
+void tick_sight(State &s, const Vec3 &skater);
+std::string stamp(); // the local time, for file names: 20261017-130012
+// ---- park-making (domination_tools.cpp) ----------------------------------------------------
+void tick_scan(State &s);
+void tick_survey(State &s, Clock::time_point now);
+bool face(const Vec3 &p, float heading);
+// ---- the score HUD (domination_hud.cpp) ----------------------------------------------------
+// Reads every watched field into `now`. False without the model.
+bool read_hud(State &s);
+} // namespace dingosdk::domination::detail
diff --git a/Extension/Domination/domination_menu.cpp b/Extension/Domination/domination_menu.cpp
new file mode 100644
index 0000000..e30fae5
--- /dev/null
+++ b/Extension/Domination/domination_menu.cpp
@@ -0,0 +1,118 @@
+#include "domination_menu.h"
+#ifdef DINGOSDK_CUSTOM_MODES // cmake/Runtime.cmake: Custom Multiplayer is in the tree
+#include "domination.h"
+#include "Extension/CustomModes/custom_modes.h"
+#include <algorithm>
+#include <array>
+#include <string>
+#include <vector>
+
+// Domination's tab on the Multiplayer page (Extension/CustomModes): its panel, built from
+// domination::snapshot() and run with its console commands.
+namespace dingosdk::domination {
+namespace {
+std::string clock(int seconds) {
+    return std::to_string(seconds / 60) + ":" + (seconds % 60 < 10 ? "0" : "") + std::to_string(seconds % 60);
+}
+// The round lengths the menu steps through, and the next one each way from `now`.
+int stepped(int now, int way) {
+    constexpr std::array lengths{60, 120, 180, 300, 420, 600, 900};
+    if (way > 0) {
+        for (const int length : lengths)
+            if (length > now) return length;
+        return lengths.back();
+    }
+    for (auto it = lengths.rbegin(); it != lengths.rend(); ++it)
+        if (*it < now) return *it;
+    return lengths.front();
+}
+
+custom_modes::Panel panel() {
+    const auto d = snapshot();
+    custom_modes::Panel p;
+    p.description = "Own the most spots in the park. The best single trick landed on a spot owns it; a higher one steals it.";
+    p.available = d.started && d.available;
+    p.unavailable = !d.started             ? std::string("Domination is not running in this build.")
+                  : !d.map_problem.empty() ? d.map_problem
+                                           : "No Domination park" + (d.problem.empty() ? std::string(".") : " (" + d.problem + ").");
+    // The park's map: loaded first by Start and hosting when it is another one. A map that isn't
+    // here is only named (nothing to load).
+    const bool missing = d.map_status == MapStatus::missing || d.map_status == MapStatus::off;
+    if (!missing) p.map = d.park_level;
+    p.map_name = d.map + (missing ? (d.map_status == MapStatus::off ? " (switched off)" : " (not downloaded)") : d.elsewhere ? "" : " (this map)");
+    p.map_here = !d.elsewhere;
+    // Between rounds, whoever starts them picks the map (each map's first park) and then a park on it,
+    // from dropdowns.
+    const bool picks = !d.running && !d.pending && (d.controls || !d.others);
+    const auto state_note = [](MapStatus status) {
+        return status == MapStatus::missing ? std::string("not downloaded") : status == MapStatus::off ? std::string("switched off") : std::string();
+    };
+    std::vector<custom_modes::Choice> parks_here;
+    for (const auto &k : d.parks) {
+        if (std::none_of(p.map_choices.begin(), p.map_choices.end(), [&](const custom_modes::Choice &c) { return c.label == k.map; }))
+            p.map_choices.push_back({k.map, "domination set park " + k.id, k.here ? std::string("this map") : state_note(k.status), k.map == d.map});
+        if (k.map == d.map)
+            parks_here.push_back({k.name, "domination set park " + k.id, std::to_string(k.spots) + " spots",
+                                  d.chosen >= 0 && d.parks[static_cast<std::size_t>(d.chosen)].id == k.id});
+    }
+    if (!picks || p.map_choices.size() < 2) p.map_choices.clear();
+    if (d.running) {
+        // The round's park stays to the end; the Park row is back between rounds.
+        p.status.push_back({"Park", d.park});
+        p.status.push_back({"Round", (d.multiplayer ? std::string("With everyone, ") : std::string("Solo, ")) +
+                                         (d.countdown ? std::string("starting") : clock(d.left) + " left")});
+        if (d.team >= 0) p.status.push_back({"Team", d.team == 0 ? "Red" : "Blue"});
+        p.status.push_back({"You own", std::to_string(d.owned) + " of " + std::to_string(d.spots) + " spots"});
+        for (std::size_t i = 0; i < d.standings.size() && i < 8; ++i) p.status.push_back({std::to_string(i + 1) + ".", d.standings[i]});
+        p.buttons.push_back({d.multiplayer && !d.starter && !d.controls ? "Leave round" : "Stop round", {}, "domination stop"});
+    } else {
+        if (d.others) p.status.push_back({"Rounds", d.controls ? std::string("You start them for everyone") : d.controller + " starts them"});
+        // This player's rounds so far (domination stats): in all, in the chosen park, and with others.
+        if (d.rounds) {
+            std::string played = std::to_string(d.rounds) + (d.rounds == 1 ? " round" : " rounds");
+            if (d.chosen >= 0) played += ", " + std::to_string(d.parks[static_cast<std::size_t>(d.chosen)].played) + " in this park";
+            if (d.online) played += ", " + std::to_string(d.online) + " with others (" + std::to_string(d.won) + " won)";
+            p.status.push_back({"You've played", played});
+        }
+        // The park: a dropdown of the chosen map's (the Map row above picks the map).
+        if (d.chosen >= 0) {
+            custom_modes::Setting park{"Park", d.parks[static_cast<std::size_t>(d.chosen)].name + " (" + std::to_string(d.spots) + " spots)"};
+            park.enabled = picks && parks_here.size() > 1;
+            park.choices = std::move(parks_here);
+            p.settings.push_back(std::move(park));
+        }
+        p.settings.push_back({"Round length", clock(d.duration), {}, "domination set duration " + std::to_string(stepped(d.duration, -1)),
+                              "domination set duration " + std::to_string(stepped(d.duration, 1))});
+        p.settings.push_back({"Players", d.solo ? "Just me" : d.others ? "Everyone in the session" : "Everyone (nobody else here)",
+                              std::string("domination set players ") + (d.solo ? "everyone" : "solo")});
+        p.settings.push_back({"Teams", d.teams ? "Red against blue" : "Free-for-all", std::string("domination set teams ") + (d.teams ? "off" : "on")});
+        if (d.pending) p.buttons.push_back({"Start round", "Loading the map...", {}, false});
+        else if (d.others && !d.controls) {
+            // In someone else's session their rounds take everyone in; a round alone is still yours to play.
+            p.buttons.push_back({"Start round", d.controller + " starts the rounds", {}, false});
+            p.buttons.push_back({"Play a round alone", {}, "domination start solo", p.available && !d.elsewhere});
+            p.buttons.push_back({"Back into the round", "If you left it", "domination join", true});
+        } else p.buttons.push_back({"Start round", missing ? "Get the map first" : d.elsewhere ? "Loads the map, then starts" : std::string(), "domination start",
+                                    p.available});
+    }
+    p.note = d.pending ? std::string("Loading the park's map. The round starts when you're in it.")
+           : d.running ? std::string("Stop the round to pick another park.")
+           : missing   ? std::string("Pick a park on a map you have, or get this one and come back.")
+           : !d.others ? std::string("Every round starts with every spot open. In a session, every player on the map plays the host's rounds.")
+           : d.controls ? std::string("You run this session's rounds: everyone on the map is in each round you start, late arrivals too.")
+           : d.controller + " runs this session's rounds: when one starts, you're in it.";
+    return p;
+}
+} // namespace
+
+void register_custom_mode() {
+    // (Joining a Domination game needs nothing more: the host's rounds take every player in.)
+    custom_modes::add({"domination", "Domination", "Own the most spots", panel, {}});
+}
+}
+#else
+// Without Custom Multiplayer, Domination is played from the console alone.
+namespace dingosdk::domination {
+void register_custom_mode() {}
+}
+#endif
