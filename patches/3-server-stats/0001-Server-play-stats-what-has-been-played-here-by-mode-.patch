diff --git a/Server/server_stats.cpp b/Server/server_stats.cpp
new file mode 100644
index 0000000..9ac68ae
--- /dev/null
+++ b/Server/server_stats.cpp
@@ -0,0 +1,167 @@
+#include "server_stats.h"
+#include "Engine/Core/Json/json.h"
+#include "Extension/Throwdowns/throwdown_wire.h"
+#include <algorithm>
+#include <chrono>
+#include <format>
+#include <fstream>
+#include <sstream>
+#include <stdexcept>
+#include <vector>
+
+namespace dingosdk::server {
+using multiplayer::ThrowdownMessage;
+using Kind = ThrowdownMessage::Kind;
+
+namespace {
+// A game not heard from for this long is over (Domination players resend their boards every few
+// seconds; a throwdown sends at least every turn).
+constexpr std::uint64_t forget_us = 10ull * 60 * 1'000'000;
+// Domination's messages: u8 tag 0xD0, u8 version, u8 type, u32 park, u32 round, ... The park and
+// round are in every type since version 4.
+constexpr std::uint8_t domination_tag = 0xD0, domination_since = 4;
+constexpr std::size_t domination_header = 11;
+
+std::string mode(std::string_view series) {
+    if (series == "JamSession") return "Jam";
+    if (series == "SpotBattle") return "Spot Battle";
+    if (series == "ThrowdownSkate") return "S.K.A.T.E.";
+    return "Throwdown"; // the series is peer text: never kept as it came
+}
+std::uint32_t u32(std::span<const std::uint8_t> b, std::size_t at) {
+    return b[at] | (b[at + 1] << 8) | (b[at + 2] << 16) | (static_cast<std::uint32_t>(b[at + 3]) << 24);
+}
+std::string today() {
+    const std::chrono::year_month_day day{std::chrono::floor<std::chrono::days>(std::chrono::system_clock::now())};
+    return std::format("{:04}-{:02}-{:02}", static_cast<int>(day.year()), static_cast<unsigned>(day.month()),
+                       static_cast<unsigned>(day.day()));
+}
+std::string plural(std::uint64_t n, const char *one, const char *many) { return std::to_string(n) + " " + (n == 1 ? one : many); }
+} // namespace
+
+bool PlayStats::load() {
+    if (file_.empty() || !std::filesystem::exists(file_)) return true;
+    try {
+        std::ifstream in(file_, std::ios::binary);
+        std::stringstream text;
+        text << in.rdbuf();
+        const auto json = Json::parse(text.str());
+        Table table;
+        if (json.contains("played") && json.at("played").is_object())
+            for (const auto &[mode, maps] : json.at("played").items())
+                if (maps.is_object())
+                    for (const auto &[map, count] : maps.items())
+                        if (count.is_object()) table[mode][map] = {count.value<std::uint64_t>("games", 0), count.value<std::uint64_t>("players", 0)};
+        table_ = std::move(table);
+        since_ = json.value<std::string>("since", "");
+        return true;
+    } catch (...) {
+        return false;
+    }
+}
+
+void PlayStats::save() {
+    if (!dirty_ || file_.empty()) return;
+    auto played = Json::object();
+    for (const auto &[mode, maps] : table_)
+        for (const auto &[map, count] : maps) {
+            auto entry = Json::object();
+            entry["games"] = count.games;
+            entry["players"] = count.players;
+            played[mode][map] = std::move(entry);
+        }
+    auto json = Json::object();
+    json["since"] = since_;
+    json["played"] = std::move(played);
+    // (Written beside and moved over, so a crash mid-write leaves the last one.)
+    std::filesystem::create_directories(file_.parent_path());
+    const auto temporary = std::filesystem::path(file_).concat(".tmp");
+    {
+        std::ofstream out(temporary, std::ios::binary | std::ios::trunc);
+        out << json.dump(2) << '\n';
+        if (!out) throw std::runtime_error("cannot write " + temporary.string());
+    }
+    std::filesystem::rename(temporary, file_);
+    dirty_ = false;
+}
+
+void PlayStats::add(const std::string &mode, const std::string &map, std::uint64_t players) {
+    auto &count = table_[mode][map];
+    ++count.games;
+    count.players += players;
+    if (since_.empty()) since_ = today();
+    dirty_ = true;
+}
+void PlayStats::add_player(const std::string &mode, const std::string &map) {
+    ++table_[mode][map].players;
+    dirty_ = true;
+}
+
+void PlayStats::relayed(std::uint64_t sender, std::span<const std::uint8_t> bytes, const std::string &map, std::uint64_t now) {
+    if (bytes.size() >= domination_header && bytes[0] == domination_tag) {
+        if (bytes[1] < domination_since) return;
+        auto [it, fresh] = rounds_.try_emplace({u32(bytes, 3), u32(bytes, 7)});
+        auto &round = it->second;
+        round.last = now;
+        if (fresh) {
+            round.map = map;
+            round.players.insert(sender);
+            add("Domination", map, 1);
+        } else if (round.players.insert(sender).second) add_player("Domination", round.map);
+        return;
+    }
+    const auto decoded = multiplayer::decode_throwdown(bytes);
+    if (!decoded) return;
+    const auto &m = *decoded;
+    const Key key{m.leader, m.id};
+    if (m.kind == Kind::offer) {
+        if (sender == m.leader) series_[key] = {m.series, now};
+        return;
+    }
+    const bool start = m.kind == Kind::start, challenge = m.kind == Kind::challenge_start;
+    if ((!start && !challenge) || sender != m.leader) return;
+    if (const auto counted = started_.find(key); counted != started_.end()) {
+        counted->second = now; // heard again
+        return;
+    }
+    started_[key] = now;
+    const auto offered = series_.find(key);
+    add(challenge ? std::string("Coop challenge") : mode(offered != series_.end() ? offered->second.first : std::string_view{}), map,
+        m.order.size());
+    if (offered != series_.end()) series_.erase(offered);
+}
+
+void PlayStats::tick(std::uint64_t now) {
+    const auto quiet = [&](std::uint64_t last) { return now > last && now - last > forget_us; };
+    std::erase_if(rounds_, [&](const auto &entry) { return quiet(entry.second.last); });
+    std::erase_if(started_, [&](const auto &entry) { return quiet(entry.second); });
+    std::erase_if(series_, [&](const auto &entry) { return quiet(entry.second.second); });
+}
+
+std::string PlayStats::report() const {
+    if (table_.empty()) return "Nothing played here yet (counted: Domination rounds, Jam, Spot Battle, S.K.A.T.E., coop challenges).";
+    std::string text = "Played here since " + since_ + ":";
+    for (const auto &[mode, maps] : table_) {
+        Count all;
+        std::vector<std::pair<std::string, Count>> by_map(maps.begin(), maps.end());
+        std::ranges::stable_sort(by_map, [](const auto &a, const auto &b) { return a.second.games > b.second.games; });
+        std::string where;
+        for (const auto &[map, count] : by_map) {
+            all.games += count.games, all.players += count.players;
+            where += (where.empty() ? "" : ", ") + map + " " + std::to_string(count.games);
+        }
+        text += std::format("\n  {}: {} ({} in all; {})", mode, all.games, plural(all.players, "player", "players"), where);
+    }
+    return text;
+}
+
+std::string PlayStats::summary() const {
+    std::string text;
+    for (const auto &[mode, maps] : table_) {
+        std::uint64_t games = 0;
+        for (const auto &[map, count] : maps) games += count.games;
+        text += (text.empty() ? "" : ", ") + mode + " " + std::to_string(games);
+    }
+    return text;
+}
+} // namespace dingosdk::server
