diff --git a/Server/Test/server_stats_tests.cpp b/Server/Test/server_stats_tests.cpp
new file mode 100644
index 0000000..6989008
--- /dev/null
+++ b/Server/Test/server_stats_tests.cpp
@@ -0,0 +1,132 @@
+#include "Server/server_stats.h"
+#include "Extension/Throwdowns/throwdown_wire.h"
+#include <cstdio>
+#include <filesystem>
+#include <fstream>
+#include <string>
+#include <vector>
+
+using namespace dingosdk;
+using namespace dingosdk::server;
+using multiplayer::ThrowdownMessage;
+using Kind = ThrowdownMessage::Kind;
+
+namespace {
+int failures = 0;
+void check(bool condition, const char *what) {
+    if (condition) return;
+    ++failures;
+    std::fprintf(stderr, "FAILED: %s\n", what);
+}
+constexpr std::uint64_t zee = 76561198000000001ULL, kush = 76561198000000002ULL, tally = 76561198000000003ULL;
+constexpr std::uint64_t second = 1'000'000;
+const std::string sanvan = "San Vansterdam", s3i = "Skate 3 Improved";
+
+std::vector<std::uint8_t> throwdown(Kind kind, std::string series = {}, std::vector<std::uint64_t> order = {}, std::uint32_t id = 7) {
+    ThrowdownMessage m;
+    m.kind = kind;
+    m.leader = zee;
+    m.id = id;
+    m.series = std::move(series);
+    m.order = std::move(order);
+    if (kind == Kind::offer) m.placement = {1, 2, 3};
+    if (kind == Kind::challenge_start) m.challenge = "Plot-014-OTS-03";
+    return multiplayer::encode_throwdown(m);
+}
+// Domination's header (domination_wire.h): u8 0xD0, u8 version, u8 type, u32 park, u32 round, then the rest.
+std::vector<std::uint8_t> domination(std::uint32_t park, std::uint32_t round, std::uint8_t version = 4, std::uint8_t type = 2) {
+    std::vector<std::uint8_t> b{0xD0, version, type};
+    for (const auto v : {park, round})
+        for (int i = 0; i < 4; ++i) b.push_back(static_cast<std::uint8_t>(v >> (8 * i)));
+    b.push_back(0); // (a board's count, and so on: not read)
+    return b;
+}
+PlayStats::Count count(const PlayStats &s, const std::string &mode, const std::string &map) {
+    const auto m = s.table().find(mode);
+    if (m == s.table().end()) return {};
+    const auto c = m->second.find(map);
+    return c == m->second.end() ? PlayStats::Count{} : c->second;
+}
+
+void throwdowns() {
+    PlayStats s;
+    s.relayed(zee, throwdown(Kind::offer, "JamSession"), sanvan, 0);
+    check(s.table().empty() && !s.changed(), "an offer is not a game");
+    s.relayed(kush, throwdown(Kind::start, {}, {zee, kush}), sanvan, second);
+    check(s.table().empty(), "only the leader starts a throwdown");
+    s.relayed(zee, throwdown(Kind::start, {}, {zee, kush, tally}), sanvan, 2 * second);
+    check((count(s, "Jam", sanvan) == PlayStats::Count{1, 3}), "a Jam started with three players");
+    check(s.changed() && !s.since().empty(), "counted from today");
+    s.relayed(zee, throwdown(Kind::start, {}, {zee, kush, tally}), sanvan, 3 * second);
+    check((count(s, "Jam", sanvan) == PlayStats::Count{1, 3}), "a start heard twice counts once");
+    // One started before the server heard its offer: counted, as a throwdown.
+    s.relayed(zee, throwdown(Kind::start, {}, {zee}, 8), s3i, 4 * second);
+    check((count(s, "Throwdown", s3i) == PlayStats::Count{1, 1}), "a start without its offer");
+    s.relayed(zee, throwdown(Kind::offer, "ThrowdownSkate", {}, 9), s3i, 5 * second);
+    s.relayed(zee, throwdown(Kind::start, {}, {zee, tally}, 9), s3i, 6 * second);
+    check((count(s, "S.K.A.T.E.", s3i) == PlayStats::Count{1, 2}), "S.K.A.T.E. by its series");
+    s.relayed(zee, throwdown(Kind::challenge_start, "Challenges", {zee, kush}, 10), s3i, 7 * second);
+    check((count(s, "Coop challenge", s3i) == PlayStats::Count{1, 2}), "a coop challenge");
+    s.relayed(zee, throwdown(Kind::score), sanvan, 8 * second);
+    check(s.table().size() == 4, "scores, rows and turns are not games");
+}
+
+void rounds() {
+    PlayStats s;
+    s.relayed(zee, domination(0xAAAA, 1), s3i, 0);
+    check((count(s, "Domination", s3i) == PlayStats::Count{1, 1}), "a round, the first time it is heard");
+    s.relayed(zee, domination(0xAAAA, 1), s3i, second);
+    s.relayed(kush, domination(0xAAAA, 1, 4, 1), s3i, 2 * second);
+    s.relayed(kush, domination(0xAAAA, 1), s3i, 3 * second);
+    check((count(s, "Domination", s3i) == PlayStats::Count{1, 2}), "each player once, whatever they send");
+    s.relayed(tally, domination(0xAAAA, 2), s3i, 4 * second);
+    s.relayed(tally, domination(0xBBBB, 1), sanvan, 5 * second);
+    check(count(s, "Domination", s3i).games == 2 && count(s, "Domination", sanvan).games == 1, "a round is its park and number");
+    s.relayed(zee, domination(0xCCCC, 1, 3), s3i, 6 * second);
+    check(count(s, "Domination", s3i).games == 2, "an older version's messages are not read");
+    s.relayed(zee, std::vector<std::uint8_t>{0xD0, 4, 2, 1}, s3i, 7 * second);
+    check(count(s, "Domination", s3i).games == 2, "a short message is not read");
+    // Quiet for ten minutes: forgotten (it was counted).
+    s.tick(7 * second + 11 * 60 * second);
+    s.relayed(zee, domination(0xAAAA, 1), s3i, 12 * 60 * second);
+    check(count(s, "Domination", s3i).games == 3, "a round forgotten after ten quiet minutes");
+}
+
+void file() {
+    const auto folder = std::filesystem::temp_directory_path() / "reskate-server-stats-test";
+    std::filesystem::remove_all(folder);
+    const auto path = folder / "data" / "stats.json";
+    {
+        PlayStats s(path);
+        check(s.load(), "no file: nothing played");
+        s.relayed(zee, domination(1, 1), s3i, 0);
+        s.relayed(kush, domination(1, 1), s3i, 0);
+        s.relayed(zee, throwdown(Kind::start, {}, {zee}), sanvan, 0);
+        s.save();
+        check(!s.changed() && std::filesystem::exists(path), "saved");
+    }
+    PlayStats again(path);
+    check(again.load(), "read back");
+    check((count(again, "Domination", s3i) == PlayStats::Count{1, 2}) && count(again, "Throwdown", sanvan).games == 1, "the counts survive");
+    check(!again.since().empty(), "and the day counting started");
+    const auto report = again.report();
+    check(report.find("Domination: 1 (2 players in all; Skate 3 Improved 1)") != std::string::npos, "the report");
+    check(again.summary() == "Domination 1, Throwdown 1", "the summary");
+    { std::ofstream(path, std::ios::trunc) << "{ not json"; }
+    PlayStats broken(path);
+    check(!broken.load(), "an unreadable file says so");
+    std::filesystem::remove_all(folder);
+}
+} // namespace
+
+int main() {
+    throwdowns();
+    rounds();
+    file();
+    if (failures) {
+        std::fprintf(stderr, "%d server stats check(s) failed\n", failures);
+        return 1;
+    }
+    std::puts("server stats: all checks passed");
+    return 0;
+}
