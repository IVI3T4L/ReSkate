@@ -0,0 +1,65 @@
+#pragma once
+#include <cstdint>
+#include <filesystem>
+#include <map>
+#include <set>
+#include <span>
+#include <string>
+#include <utility>
+
+namespace dingosdk::server {
+// What has been played on this server: games started, by mode and map, with how many took part,
+// kept in data/stats.json across restarts. Read from the throwdown packets the server relays
+// anyway (nothing here changes what it sends) and kept on the server alone:
+// - throwdowns (Extension/Throwdowns/throwdown_wire.h): Jam, Spot Battle, S.K.A.T.E. (counted at
+//   their start, with the players in it) and coop challenges;
+// - Domination rounds (Extension/Domination/domination_wire.h, when it is in): every message
+//   starts u8 0xD0, u8 version, u8 type, u32 park, u32 round; a round is counted the first time
+//   it is heard, and each player the first time they send for it.
+class PlayStats {
+  public:
+    struct Count {
+        std::uint64_t games{}, players{}; // players: summed over the games (one player in two games is two)
+        bool operator==(const Count &) const = default;
+    };
+    // mode ("Domination", "Jam", ...) -> map -> count
+    using Table = std::map<std::string, std::map<std::string, Count>, std::less<>>;
+
+    explicit PlayStats(std::filesystem::path file = {}) : file_(std::move(file)) {}
+    // Reads the file (missing: nothing played yet). False, keeping what is there, if it is unreadable.
+    bool load();
+    // Writes the file when something changed since the last write. Throws when it can't.
+    void save();
+    bool changed() const { return dirty_; }
+
+    // One relayed throwdown packet from `sender` while `map` is loaded; `now` in microseconds.
+    void relayed(std::uint64_t sender, std::span<const std::uint8_t> message, const std::string &map, std::uint64_t now);
+    // Forgets games that went quiet (each is counted already).
+    void tick(std::uint64_t now);
+
+    const Table &table() const { return table_; }
+    const std::string &since() const { return since_; }
+    // "Played here since 2026-10-16: Domination 12 (41 players; Skate 3 Improved 9, San Vansterdam 3); Jam 4 (...)".
+    std::string report() const;
+    // One line for a status panel: "Domination 12, Jam 4" (empty: nothing yet).
+    std::string summary() const;
+
+  private:
+    void add(const std::string &mode, const std::string &map, std::uint64_t players);
+    void add_player(const std::string &mode, const std::string &map);
+
+    std::filesystem::path file_;
+    Table table_;
+    std::string since_; // the day the first game was counted (UTC, YYYY-MM-DD)
+    bool dirty_{};
+    using Key = std::pair<std::uint64_t, std::uint32_t>; // throwdowns: leader, their number for it
+    std::map<Key, std::pair<std::string, std::uint64_t>> series_; // offered: its series, last heard
+    std::map<Key, std::uint64_t> started_;                       // counted: last heard
+    struct Round {
+        std::string map;
+        std::set<std::uint64_t> players;
+        std::uint64_t last{};
+    };
+    std::map<std::pair<std::uint32_t, std::uint32_t>, Round> rounds_; // Domination: park, round
+};
+} // namespace dingosdk::server
